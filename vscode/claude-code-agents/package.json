{
  "name": "claude-code-agents",
  "displayName": "Claude Code Agents Dashboard",
  "description": "Dispatch remote work over SSH and watch per-agent-CLI token usage from the activity bar.",
  "version": "0.1.0",
  "publisher": "edotau",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:claudeCodeAgents.usage",
    "onView:claudeCodeTasks.page",
    "onView:claudeCodeTasks.panel",
    "onStartupFinished"
  ],
  "extensionPack": [
    "github.vscode-pull-request-github"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeAgents",
          "title": "Agents Dashboard",
          "icon": "media/hubot.svg"
        },
        {
          "id": "claudeCodeTasks",
          "title": "Tasks",
          "icon": "media/tasks.svg"
        }
      ],
      "panel": [
        {
          "id": "claudeCodeTasksPanel",
          "title": "Tasks",
          "icon": "media/tasks.svg"
        }
      ]
    },
    "views": {
      "claudeCodeAgents": [
        {
          "id": "claudeCodeAgents.usage",
          "name": "Agents Dashboard",
          "type": "webview"
        }
      ],
      "claudeCodeTasks": [
        {
          "id": "claudeCodeTasks.page",
          "name": "Tasks",
          "type": "webview"
        }
      ],
      "claudeCodeTasksPanel": [
        {
          "id": "claudeCodeTasks.panel",
          "name": "Tasks",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeAgents.dispatch",
        "title": "Dispatch…",
        "icon": "$(rocket)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.showUsage",
        "title": "Show Agents Dashboard",
        "icon": "$(graph)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.refreshUsage",
        "title": "Refresh Agents Dashboard",
        "icon": "$(refresh)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.openUsageEditor",
        "title": "Open Agents Dashboard in Editor",
        "icon": "$(pulse)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.servePhone",
        "title": "Serve for Phone (Tailscale)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.servePhoneStop",
        "title": "Stop Serving for Phone",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeTasks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.open",
        "title": "Open",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.openInEditor",
        "title": "Open Tasks in Editor",
        "icon": "$(link-external)",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.setupToken",
        "title": "Set Bitbucket token",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.startAgent",
        "title": "Copy task prompt & open Claude",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.show",
        "title": "Show Tasks",
        "icon": "$(tasklist)",
        "category": "Claude Code Tasks"
      },
      {
        "command": "claudeCodeTasks.popOut",
        "title": "Open Tasks in New Window",
        "icon": "$(multiple-windows)",
        "category": "Claude Code Tasks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeAgents.refreshUsage",
          "when": "view == claudeCodeAgents.usage",
          "group": "navigation"
        },
        {
          "command": "claudeCodeAgents.openUsageEditor",
          "when": "view == claudeCodeAgents.usage",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.refresh",
          "when": "view == claudeCodeTasks.page",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.openInEditor",
          "when": "view == claudeCodeTasks.page",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.refresh",
          "when": "view == claudeCodeTasks.panel",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.openInEditor",
          "when": "view == claudeCodeTasks.panel",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.popOut",
          "when": "view == claudeCodeTasks.page",
          "group": "navigation"
        },
        {
          "command": "claudeCodeTasks.popOut",
          "when": "view == claudeCodeTasks.panel",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "claudeCodeAgents.openUsageEditor",
          "when": "config.claudeCodeAgents.usageEditorTitleButton",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Agents",
      "properties": {
        "claudeCodeAgents.binary": {
          "type": "string",
          "default": "claude-code",
          "description": "Path or name of the claude-code binary."
        },
        "claudeCodeAgents.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "SSH hosts offered by the Dispatch… quick-pick."
        },
        "claudeCodeAgents.usageRefreshSeconds": {
          "type": "number",
          "default": 60,
          "description": "Usage popover auto-refresh interval, in seconds (minimum 15)."
        },
        "claudeCodeAgents.usageShow": {
          "type": "string",
          "enum": [
            "used",
            "left"
          ],
          "default": "used",
          "description": "Status bar percentage: used or left"
        },
        "claudeCodeAgents.usageStatusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Status bar side for the usage segment."
        },
        "claudeCodeAgents.usageStatusBarPriority": {
          "type": "number",
          "default": 1000000,
          "description": "Status bar sort priority for the usage segment."
        },
        "claudeCodeAgents.usageStatusBarAgents": {
          "type": "boolean",
          "default": true,
          "description": "Append per-agent token totals (codex, opencode, copilot) to the status bar."
        },
        "claudeCodeAgents.usageDays": {
          "type": "number",
          "default": 30,
          "description": "Window, in days, for the per-agent totals; passed as --days."
        },
        "claudeCodeAgents.usageOpenIn": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "description": "Where the status bar item opens the Usage view: the extension's sidebar view, or a tab in the editor area."
        },
        "claudeCodeAgents.usageEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "Show an Open Agents Dashboard in Editor button in every editor's title bar."
        },
        "claudeCodeAgents.tasksRefreshSeconds": {
          "type": "number",
          "default": 120,
          "description": "Tasks page auto-refresh interval, in seconds, while it is visible (minimum 15)."
        },
        "claudeCodeAgents.tasksJiraBaseUrl": {
          "type": "string",
          "default": "https://jira.biscrum.com",
          "description": "Jira Data Center base URL the Tasks page queries and links issue keys to, e.g. https://jira.example.com"
        },
        "claudeCodeAgents.tasksStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current branch's pull request as a status bar segment."
        },
        "claudeCodeAgents.bitbucketUrl": {
          "type": "string",
          "default": "https://bitbucket.biscrum.com",
          "description": "Bitbucket Data Center server URL the Tasks page queries directly."
        },
        "claudeCodeAgents.tasksInstallGitHubExtension": {
          "type": "boolean",
          "default": true,
          "description": "On activation, install the GitHub Pull Requests and Issues extension if it's missing (the Tasks page deep-links into it)."
        },
        "claudeCodeAgents.tasksDefaultSource": {
          "type": "string",
          "enum": [
            "jira",
            "github",
            "bitbucket"
          ],
          "default": "jira",
          "description": "Source the Tasks page opens on."
        },
        "claudeCodeAgents.tasksVisibleSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "jira",
              "github",
              "bitbucket"
            ]
          },
          "default": [
            "jira",
            "github",
            "bitbucket"
          ],
          "description": "Sources shown in the Tasks page source bar (the last one cannot be hidden)."
        },
        "claudeCodeAgents.tasksGitHubRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repos (owner/name) listed in the Tasks page, in addition to the workspace folders’ github.com remotes."
        },
        "claudeCodeAgents.tasksBitbucketRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Bitbucket Data Center repos (PROJECT/repo) listed under the \"This repo\" preset, in addition to the workspace folders’ remotes."
        },
        "claudeCodeAgents.tasksJiraProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Jira project keys the Jira source is scoped to (empty = every project the token can see)."
        },
        "claudeCodeAgents.tasksDefaultQuery.github": {
          "type": "string",
          "default": "is:open",
          "description": "Query the GitHub source starts with; right-click a preset chip to set it."
        },
        "claudeCodeAgents.tasksDefaultQuery.bitbucket": {
          "type": "string",
          "default": "is:pr is:open review-requested:@me",
          "description": "Query the Bitbucket source starts with; right-click a preset chip to set it."
        },
        "claudeCodeAgents.tasksDefaultQuery.jira": {
          "type": "string",
          "default": "is:issue is:open assignee:@me",
          "description": "Query the Jira source starts with; right-click a preset chip to set it."
        },
        "claudeCodeAgents.tasksPageSize": {
          "type": "number",
          "default": 36,
          "description": "Rows fetched per repo per page in the Tasks page."
        },
        "claudeCodeAgents.tasksViewMode": {
          "type": "string",
          "enum": [
            "list",
            "board"
          ],
          "default": "list",
          "description": "How the Tasks page shows rows until the List | Board toggle is used (the toggle is remembered per source and workspace)."
        },
        "claudeCodeAgents.tasksOpenIn": {
          "type": "string",
          "enum": [
            "panel",
            "sidebar",
            "editor"
          ],
          "default": "panel",
          "description": "Where \"Show Tasks\" and the status bar segment open the Tasks page: the bottom Panel, the activity-bar sidebar, or an editor tab. Both the Panel and sidebar views exist; hide the one you don’t use (right-click its icon)."
        },
        "claudeCodeAgents.tailscaleBinary": {
          "type": "string",
          "default": "tailscale",
          "description": "Path or name of the tailscale CLI used to switch exit nodes (the peer list comes from `claude-code tailscale status`)."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only runs the claude-code binary; never evaluates workspace content."
    }
  }
}
