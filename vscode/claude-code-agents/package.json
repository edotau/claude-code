{
  "name": "claude-code-agents",
  "displayName": "Claude Code Agents Dashboard",
  "description": "Dispatch remote work over SSH and watch per-agent-CLI token usage from the activity bar.",
  "version": "0.1.0",
  "publisher": "edotau",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:claudeCodeAgents.usage",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeAgents",
          "title": "Agents Dashboard",
          "icon": "media/hubot.svg"
        }
      ]
    },
    "views": {
      "claudeCodeAgents": [
        {
          "id": "claudeCodeAgents.usage",
          "name": "Agents Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeAgents.dispatch",
        "title": "Dispatch…",
        "icon": "$(rocket)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.showUsage",
        "title": "Show Agents Dashboard",
        "icon": "$(graph)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.refreshUsage",
        "title": "Refresh Agents Dashboard",
        "icon": "$(refresh)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.openUsageEditor",
        "title": "Open Agents Dashboard in Editor",
        "icon": "$(pulse)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.servePhone",
        "title": "Serve for Phone (Tailscale)",
        "category": "Claude Code Agents"
      },
      {
        "command": "claudeCodeAgents.servePhoneStop",
        "title": "Stop Serving for Phone",
        "category": "Claude Code Agents"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeAgents.refreshUsage",
          "when": "view == claudeCodeAgents.usage",
          "group": "navigation"
        },
        {
          "command": "claudeCodeAgents.openUsageEditor",
          "when": "view == claudeCodeAgents.usage",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "claudeCodeAgents.openUsageEditor",
          "when": "config.claudeCodeAgents.usageEditorTitleButton",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Agents",
      "properties": {
        "claudeCodeAgents.binary": {
          "type": "string",
          "default": "claude-code",
          "description": "Path or name of the claude-code binary."
        },
        "claudeCodeAgents.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "SSH hosts offered by the Dispatch… quick-pick."
        },
        "claudeCodeAgents.usageRefreshSeconds": {
          "type": "number",
          "default": 60,
          "description": "Usage popover auto-refresh interval, in seconds (minimum 15)."
        },
        "claudeCodeAgents.usageShow": {
          "type": "string",
          "enum": [
            "used",
            "left"
          ],
          "default": "used",
          "description": "Status bar percentage: used or left"
        },
        "claudeCodeAgents.usageStatusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Status bar side for the usage segment."
        },
        "claudeCodeAgents.usageStatusBarPriority": {
          "type": "number",
          "default": 1000000,
          "description": "Status bar sort priority for the usage segment."
        },
        "claudeCodeAgents.usageStatusBarAgents": {
          "type": "boolean",
          "default": true,
          "description": "Append per-agent token totals (codex, opencode, copilot) to the status bar."
        },
        "claudeCodeAgents.usageDays": {
          "type": "number",
          "default": 30,
          "description": "Window, in days, for the per-agent totals; passed as --days."
        },
        "claudeCodeAgents.usageOpenIn": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "description": "Where the status bar item opens the Usage view: the extension's sidebar view, or a tab in the editor area."
        },
        "claudeCodeAgents.usageEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "Show an Open Agents Dashboard in Editor button in every editor's title bar."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only runs the claude-code binary; never evaluates workspace content."
    }
  }
}
