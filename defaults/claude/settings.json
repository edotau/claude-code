{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/slash-usage",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Agent",
      "Edit",
      "Read",
      "Write",
      "WebFetch(*)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/internal/agentconfig/agents.json)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Edit(~/.ssh/**)",
      "Edit(**/state/vault.db)",
      "Edit(**/.credentials.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/internal/agentconfig/agents.json)",
      "Write(~/.claude/internal/agentconfig/agents.json)",
      "Write(~/.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  },
  "outputStyle": "Concise",
  "theme": "auto"
}
