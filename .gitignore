# This repo IS ~/.claude: track the harness, ignore everything Claude Code writes at runtime.

# Claude Code runtime state
/projects/
/sessions/
/session-env/
/shell-snapshots/
/history.jsonl
/todos/
/tasks/
/plans/
/file-history/
/paste-cache/
/ide/
/statsig/
/debug/
/telemetry/
/cache/
/image-cache/
/backups/
/plugins/
/chrome/
/daemon/
/daemon.*
/jobs/
/uploads/
/local/
/logs/
/usage-data/
/config.json
/stats-cache.json
/daemon-auth-*
/mcp/
/remote/
/session-data/
/mcp-needs-auth-cache.json
/.last-*
/.claude/
/state/
/.orca/
/memory/
# Memory markdown never rides a harness commit, wherever a legacy or native tool drops it.
/agent-memory/
/docs/memory/
/docs/plans/
/docs/reports/
/docs/handoffs/
MEMORY.md
!docs/templates/examples/memory/MEMORY.md
SEARCHABLE.md
/worktrees/
# claude.ai account skills Claude Code downloads each sync round; the copy of record is claude.ai.
/skills/synced/
/skills/.trash/

# Generated settings and credentials (settings.json is rendered by `claude-code install`)
/settings.json
/settings.json.bak*
/settings.local.json
/.credentials.json
/.claude.json
/env.d/
.env
.env.*
*.env
!*.env.example
*.token

# Python
.venv/
__pycache__/

# Build output
/bin/
/claude-code
*.test
*.out
coverage.*
*.coverprofile

# Skills: only the harness's own are tracked; every other dir is the user's (symlinks into ~/.agents or local copies).
/skills/*
!/skills/architecture-design
/skills/architecture-design/references/local/
!/skills/browser-automation
!/skills/database-schema
!/skills/evaluate-code
!/skills/problem-solving
!/skills/python-patterns
!/skills/reflection
!/skills/reverse-engineer
!/skills/simplify
!/skills/subagent-workflows
!/skills/testing-guidelines
!/skills/using-git-worktrees
!/skills/web-search

# Editors / OS
.DS_Store
.idea/
.vscode/

/policy-limits.json*
/remote-settings.json*
/tmp.*/
/.vaultcopy.*/
