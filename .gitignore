# This repo IS ~/.claude: track the harness, ignore everything Claude Code writes at runtime.

# Claude Code runtime state
/projects/
/sessions/
/session-env/
/shell-snapshots/
/history.jsonl
/todos/
/tasks/
/plans/
/file-history/
/paste-cache/
/ide/
/statsig/
/debug/
/telemetry/
/cache/
/image-cache/
/backups/
/plugins/
/chrome/
/daemon/
/daemon.*
/jobs/
/uploads/
/local/
/logs/
/usage-data/
/config.json
/stats-cache.json
/daemon-auth-*
/mcp/
/remote/
/session-data/
/mcp-needs-auth-cache.json
/.last-*
/.claude/
/state/
/memory/
# Memory markdown never rides a harness commit, wherever a legacy or native tool drops it.
/agent-memory/
/docs/memory/
/docs/plans/
/docs/reports/
/docs/handoffs/
MEMORY.md
!docs/templates/examples/memory/MEMORY.md
/worktrees/
# claude.ai account skills Claude Code downloads each sync round; the copy of record is claude.ai.
/skills/synced/
/skills/.trash/
# Claude Code's local feedback drafts (/feedback); never committed.
/feedback/

# Settings backups and credentials (settings.json itself is tracked)
/settings.json.bak*
/settings.local.json
/.credentials.json
/.claude.json
/env.d/
.env
.env.*
*.env
!*.env.example
*.token

# Python
.venv/
__pycache__/

# Build output
/bin/
/claude-code
*.test
*.out
coverage.*
*.coverprofile

# Skills: only the harness's own are tracked; every other dir is the user's (symlinks into ~/.agents or local copies).
/skills/*
!/skills/dbx-expert
!/skills/evaluate-code
!/skills/golang
!/skills/network-browser
!/skills/problem-solving
!/skills/reflection
!/skills/simplify
!/skills/subagent-workflows
!/skills/tailscale
!/skills/using-git-worktrees
!/skills/web-explorer

# Editors / OS
.DS_Store
.idea/
.vscode/

/policy-limits.json*
/remote-settings.json*
/tmp.*/
/.vaultcopy.*/

# Copilot repo instructions: local, not tracked
/.github/copilot-instructions.md
.impeccable

# Mods: engine-generated types; per-session dev mods
mods/*/.claude-plugin/types/
dev-mods/

# settings.WriteWithBackup lock beside settings.json
/settings.json.lock
