# Memory markdown never rides a harness commit, wherever a legacy or native tool drops it.
/agent-memory/
/docs/memory/
/docs/plans/
/docs/reports/
/docs/handoffs/
MEMORY.md
SEARCHABLE.md
/docs/knowledge/bi-*.md
/worktrees/
# claude.ai account skills Claude Code downloads each sync round; the copy of record is claude.ai.
/skills/synced/
/skills/.trash/

# Generated settings and credentials (settings.json is rendered by `claude-code install`)
/settings.json
/settings.json.bak*
/settings.local.json
/.credentials.json
/.claude.json
/env.d/*.env
/env.d/*.json
/env.d/secrets.index
/env.d/*.lock
!/env.d/*.example
!/env.d/*.example.json
.env
*.token

# Build output
/bin/
/claude-code
*.test
*.out
coverage.*
*.coverprofile

