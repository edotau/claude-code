# Written by `claude-code use` and `claude-code models --pin`; process env beats this file.
# Copy to env.d/provider.env only to seed pins by hand.

# Session provider (a name from `claude-code providers`)
HARNESS_PROVIDER=anthropic

# Every slot at once; a per-slot pin beats it
#HARNESS_MODEL=claude-opus-5

# Per-slot pins; provider:model crosses providers (implies the router)
#HARNESS_OPUS_MODEL=claude-opus-5
#HARNESS_SONNET_MODEL=claude-sonnet-5
#HARNESS_HAIKU_MODEL=openai:gpt-5-nano
#HARNESS_FABLE_MODEL=claude-fable-5-1
