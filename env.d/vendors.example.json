{
  "_comment": "Copy to env.d/vendors.json. A vendor entry replaces the built-in whole; null removes one.",
  "vendors": {
    "opencode": {
      "permission": {
        "mode": "allow-all",
        "useGuardRules": true
      },
      "mcp": {
        "allow": [
          "github"
        ]
      },
      "launch": {
        "env": [
          "OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1"
        ]
      }
    }
  }
}
