{
  "_comment": "Copy to env.d/providers.json. Entries replace built-ins by name; null removes one. Keep keys out of this file: use auth.env (+ env.d/secrets.env) or auth.command.",
  "default": "gateway",
  "fallback": [
    "gateway",
    "anthropic"
  ],
  "opencodeLadder": [
    "chatgpt",
    "github-copilot",
    "gemini",
    "nvidia"
  ],
  "opencodePlugins": [],
  "agentPlans": {
    "claude": [
      {
        "id": "*"
      }
    ],
    "codex": [
      {
        "id": "*"
      }
    ],
    "antigravity": [
      {
        "id": "*",
        "tier": "Google AI Pro"
      }
    ],
    "copilot": [
      {
        "id": "*"
      }
    ]
  },
  "providers": {
    "gateway": {
      "kind": "anthropic",
      "base_url": "https://llm.example.com",
      "routes": {
        "openai": "/v1",
        "responses": "/v1"
      },
      "auth": {
        "type": "bearer",
        "env": "GATEWAY_API_KEY"
      },
      "headers": {
        "x-team": "platform"
      },
      "models": {
        "opus": "claude-opus-5",
        "sonnet": "claude-sonnet-5",
        "haiku": "gpt-5-nano"
      },
      "one_m": true
    },
    "ollama": null
  }
}
