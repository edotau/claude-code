{
  "_comment": "Copy to env.d/providers.json. Entries replace built-ins by name; null removes one. Keep keys out of this file: use auth.env (+ env.d/secrets.env) or auth.command.",
  "default": "litellm",
  "fallback": [
    "litellm",
    "openrouter",
    "anthropic"
  ],
  "opencodeLadder": [
    "chatgpt",
    "github-copilot",
    "gemini",
    "nvidia"
  ],
  "opencodePlugins": [],
  "agentPlans": {
    "claude": [
      {
        "id": "*max_20x*",
        "tier": "Max 20x",
        "desc": "20x Pro usage",
        "provider": "Anthropic"
      },
      {
        "id": "*max_5x*",
        "tier": "Max 5x",
        "desc": "5x Pro usage",
        "provider": "Anthropic"
      }
    ],
    "codex": [
      {
        "id": "plus",
        "tier": "Plus",
        "desc": "Codex web, CLI, IDE",
        "provider": "OpenAI"
      }
    ],
    "antigravity": [
      {
        "id": "*",
        "tier": "Google AI Pro",
        "desc": "5h quota",
        "provider": "Google"
      }
    ],
    "copilot": [
      {
        "id": "individual_pro",
        "tier": "Pro+",
        "desc": "3,900 credits/mo",
        "provider": "GitHub"
      }
    ]
  },
  "providers": {
    "litellm": {
      "kind": "anthropic",
      "base_url": "https://llm.example.com",
      "routes": {
        "openai": "/v1",
        "responses": "/v1"
      },
      "auth": {
        "type": "bearer",
        "env": "LITELLM_API_KEY"
      },
      "headers": {
        "x-litellm-tags": "claude-code"
      },
      "models": {
        "opus": "claude-opus-5",
        "sonnet": "claude-sonnet-5",
        "haiku": "gpt-5-nano"
      },
      "one_m": true
    },
    "openrouter": {
      "kind": "anthropic",
      "base_url": "https://openrouter.ai/api",
      "routes": {
        "openai": "/v1"
      },
      "auth": {
        "type": "bearer",
        "env": "OPENROUTER_API_KEY",
        "command": "security find-generic-password -w -s openrouter",
        "ttl": 3600
      },
      "models": {
        "opus": "anthropic/claude-opus-5",
        "sonnet": "anthropic/claude-sonnet-5",
        "haiku": "qwen/qwen3-coder"
      }
    },
    "ollama": null
  }
}
