{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "outputStyle": "Concise",
  "switchModelsOnFlag": true,
  "theme": "auto",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "preferredNotifChannel": "auto",
  "awaySummaryEnabled": false,
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "askUserQuestionTimeout": "10m",
  "cleanupPeriodDays": 30,
  "autoConnectIde": false,
  "disableClaudeAiConnectors": true,
  "useAutoModeDuringPlan": true,
  "skipWorkflowUsageWarning": true,
  "idleCompaction": false,
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)",
      "Bash(go *)",
      "Bash(claude-code *)",
      "Bash(gofmt -l *)",
      "Bash(systemctl --user is-active *)",
      "Bash(rm -rf /tmp/*)",
      "Bash(rm -r /tmp/*)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(make lint)",
      "Bash(make fmt)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /home*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /root*)",
      "Bash(rm -rf /mnt*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf *..*)",
      "Bash(rm -r *..*)",
      "Bash(rm -rf * /*)",
      "Bash(rm -r * /*)",
      "Bash(rm -rf * ~*)",
      "Bash(rm -r * ~*)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(rm -rf /*)",
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest)",
      "Bash(npm publish:*)",
      "Bash(npx vitest run)",
      "Read(~/.aws/credentials)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(claude-code vault *)",
      "Bash(go test * ./...*)"
    ]
  }
}
