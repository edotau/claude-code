{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "outputStyle": "Concise",
  "switchModelsOnFlag": true,
  "theme": "auto",
  "tui": "default",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "preferredNotifChannel": "notifications_disabled",
  "awaySummaryEnabled": false,
  "feedbackDrafts": "off",
  "dialogExpiry": "never",
  "idleCompaction": false,
  "cleanupPeriodDays": 30,
  "remoteControlAtStartup": false,
  "autoConnectIde": false,
  "useAutoModeDuringPlan": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "300000",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run --coverage)",
      "Bash(npm run e2e:*)",
      "Bash(npx cypress run:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/env.d/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)",
      "Bash(security add-generic-password:*)",
      "Bash(security delete-generic-password:*)"
    ]
  },
  "enabledPlugins": {
    "databricks@claude-plugins-official": false,
    "impeccable@impeccable": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
