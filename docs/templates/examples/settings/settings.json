{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 12,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/slash-usage",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "permissions": {
    "allow": [
      "Agent",
      "Edit",
      "Read",
      "Write",
      "WebFetch(*)",
      "Bash(go *)",
      "Bash(claude-code *)",
      "Bash(gofmt -l *)",
      "Bash(systemctl --user is-active *)",
      "Bash(go test ./...:*)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(*/.claude/bin/rtk grep *)",
      "Bash(*/.claude/bin/rtk ls *)",
      "Bash(make *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)",
      "Edit(~/.ssh/**)",
      "Edit(**/state/vault.db)",
      "Edit(**/.credentials.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)",
      "Bash(go test * ./...*)",
      "Bash(claude-code vault set*)",
      "Bash(claude-code vault delete*)",
      "Bash(claude-code vault import*)",
      "Bash(claude-code vault edit*)",
      "Bash(claude-code vault rotate-secret*)",
      "Bash(claude-code vault get*)",
      "Bash(claude-code vault export*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "feedbackSurveyRate": 0,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true,
  "worktree": {
    "baseRef": "head"
  },
  "tui": "fullscreen",
  "useAutoModeDuringPlan": true,
  "preferredNotifChannel": "auto",
  "theme": "auto",
  "awaySummaryEnabled": false,
  "disableClaudeAiConnectors": true,
  "askUserQuestionTimeout": "never",
  "autoConnectIde": false,
  "switchModelsOnFlag": true,
  "feedbackDrafts": "off",
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|ExitPlanMode|EnterPlanMode|Bash|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PostToolUse",
            "timeout": 50
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PreCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PreToolUse --safety-scan",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PreToolUse",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SessionEnd",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SessionStart",
            "timeout": 20,
            "statusMessage": "Loading session memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook Stop",
            "timeout": 55
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook WorktreeCreate",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook WorktreeRemove",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
