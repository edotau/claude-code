{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "outputStyle": "Concise",
  "switchModelsOnFlag": true,
  "theme": "auto",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "preferredNotifChannel": "auto",
  "awaySummaryEnabled": false,
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "askUserQuestionTimeout": "10m",
  "cleanupPeriodDays": 30,
  "autoConnectIde": false,
  "disableClaudeAiConnectors": true,
  "useAutoModeDuringPlan": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)",
      "Bash(go *)",
      "Bash(claude-code *)",
      "Bash(gofmt -l *)",
      "Bash(systemctl --user is-active *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest *)",
      "Bash(npm *)",
      "Bash(npx vitest *)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|ExitPlanMode|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PostToolUse",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PreCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook safety-scan",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook PreToolUse --no-own",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SessionEnd",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SessionStart",
            "timeout": 10,
            "statusMessage": "Loading session memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook Stop",
            "timeout": 50
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook WorktreeCreate",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook WorktreeRemove",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
