{
  "claudeCode.useTerminal": true,
  "claudeCode.disableLoginPrompt": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.attachOpenFile": false,
  "claudeCode.attachSelection": false,
  "claudeCode.preferredLocation": "sidebar",
  "chat.useClaudeHooks": true,
  "chatgpt.cliExecutable": "__CLAUDE_BIN__/codex",
  "chatgpt.composerEnterBehavior": "cmdIfMultiline",
  "chatgpt.reviewDelivery": "inline",
  "chatgpt.followUpQueueMode": "steer",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "terminal.integrated.fontSize": 13.5,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.environmentChangesRelaunch": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "terminal-bash"
    },
    "Claude": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code claude"
      ],
      "env": {
        "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1"
      },
      "icon": "sparkle",
      "color": "terminal.ansiYellow"
    },
    "Codex": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code codex"
      ],
      "icon": "hubot",
      "color": "terminal.ansiWhite"
    },
    "OpenCode": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code opencode"
      ],
      "icon": "terminal",
      "color": "terminal.ansiCyan"
    },
    "Gemini": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code gemini"
      ],
      "icon": "star-full",
      "color": "terminal.ansiBlue"
    },
    "Copilot": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code copilot"
      ],
      "icon": "copilot",
      "color": "terminal.ansiMagenta"
    }
  },
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "terminal-bash"
    },
    "Claude": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code claude"
      ],
      "env": {
        "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1"
      },
      "icon": "sparkle",
      "color": "terminal.ansiYellow"
    },
    "Codex": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code codex"
      ],
      "icon": "hubot",
      "color": "terminal.ansiWhite"
    },
    "OpenCode": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code opencode"
      ],
      "icon": "terminal",
      "color": "terminal.ansiCyan"
    },
    "Gemini": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code gemini"
      ],
      "icon": "star-full",
      "color": "terminal.ansiBlue"
    },
    "Copilot": {
      "path": "bash",
      "args": [
        "-lic",
        "exec __CLAUDE_BIN__/claude-code copilot"
      ],
      "icon": "copilot",
      "color": "terminal.ansiMagenta"
    }
  },
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.defaultLocation": "editor",
  "workbench.colorTheme": "Monokai",
  "editor.fontSize": 13,
  "editor.wordWrap": "off",
  "[markdown]": {
    "editor.wordWrap": "off"
  }
}
