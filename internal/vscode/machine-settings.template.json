{
  "claudeCode.useTerminal": true,
  "claudeCode.disableLoginPrompt": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.attachOpenFile": false,
  "claudeCode.attachSelection": false,
  "claudeCode.claudeProcessWrapper": "__CLAUDE_BIN__/claude",
  "claudeCode.preferredLocation": "sidebar",
  "chat.useClaudeHooks": true,
  "chatgpt.cliExecutable": "__CLAUDE_BIN__/codex",
  "chatgpt.composerEnterBehavior": "cmdIfMultiline",
  "chatgpt.reviewDelivery": "inline",
  "chatgpt.followUpQueueMode": "steer",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "terminal.integrated.fontSize": 13.5,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.environmentChangesRelaunch": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.allowChords": false
}
