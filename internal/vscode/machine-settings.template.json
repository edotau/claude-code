{
  "claudeCode.claudeProcessWrapper": "__CLAUDE_BIN__/claude",
  "claudeCode.useTerminal": true,
  "claudeCode.usePythonEnvironment": false,
  "claudeCode.disableLoginPrompt": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.enableNewConversationShortcut": true,
  "claudeCode.useCtrlEnterToSend": true,
  "claudeCode.initialPermissionMode": "default",
  "claudeCodeChat.wsl.enabled": true,
  "claudeCodeChat.wsl.nodePath": "__CLAUDE_BIN__/claude",
  "chat.useClaudeHooks": true,
  "chat.agents.claude.preferAgentHost": true,
  "chat.editor.codex.preferAgentHost": true,
  "chat.editor.preferCopilotHarness": true,
  "chatgpt.cliExecutable": "__CLAUDE_BIN__/codex",
  "chatgpt.composerEnterBehavior": "cmdAlways",
  "chatgpt.reviewDelivery": "inline",
  "chatgpt.followUpQueueMode": "steer",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
      "args": [
        "-l"
      ]
    }
  },
  "terminal.integrated.fontSize": 13.5,
  "terminal.integrated.scrollback": 2000,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.enableImages": false,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.rightClickBehavior": "paste",
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.environmentChangesRelaunch": true,
  "terminal.integrated.localEchoEnabled": "auto",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.view.extension.claude-sessions-sidebar",
    "workbench.action.closeSidebar",
    "-workbench.action.quickOpen"
  ]
}
