{
    "env": {
        "ANTHROPIC_MODEL": "system.ai.claude-opus-5-5",
        "ANTHROPIC_BASE_URL": "https://example.cloud.databricks.com/ai-gateway/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "<your_token_will_appear_here>",
