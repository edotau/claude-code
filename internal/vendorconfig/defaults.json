{
  "vendors": {
    "codex": {
      "permission": {
        "approvalPolicy": "never",
        "sandboxMode": "danger-full-access"
      },
      "launch": {}
    },
    "opencode": {
      "launch": {
        "env": [
          "OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1"
        ]
      }
    },
    "copilot": {
      "permission": {
        "defaultPermissionMode": "allow-all"
      },
      "launch": {
        "args": [
          "--allow-all"
        ]
      }
    },
    "gemini": {
      "permission": {
        "useGuardRules": true
      },
      "launch": {
        "args": [
          "--dangerously-skip-permissions"
        ]
      }
    }
  }
}
