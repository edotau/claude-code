{
  "agents": {
    "codex": {
      "extras": {
        "approvalPolicy": "never",
        "sandboxMode": "danger-full-access"
      }
    },
    "copilot": {
      "launch": {
        "args": [
          "--allow-all"
        ]
      },
      "extras": {
        "defaultPermissionMode": "allow-all"
      }
    },
    "gemini": {
      "launch": {
        "args": [
          "--dangerously-skip-permissions"
        ]
      },
      "extras": {
        "useGuardRules": "true"
      }
    },
    "opencode": {}
  }
}
