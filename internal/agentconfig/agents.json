{
  "agents": {
    "codex": {
      "permission": {
        "approvalPolicy": "never",
        "sandboxMode": "danger-full-access"
      },
      "launch": {}
    },
    "opencode": {
      "launch": {
        "env": [
          "OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1"
        ]
      }
    },
    "copilot": {
      "permission": {
        "defaultPermissionMode": "allow-all",
        "shell": {
          "commands": [
            {
              "commands": ["go"],
              "subcommands": ["test", "vet", "build", "fmt", "list"],
              "exact": ["mod tidy"],
              "bannedFlags": ["-exec", "-toolexec", "-vettool", "-overlay"],
              "argsInside": true
            },
            {
              "commands": ["rm"],
              "check": "regularFiles",
              "summary": "rm <regular files inside the roots> (no flags, globs, symlinks, .git, state or settings files)"
            },
            {"commands": ["gofmt"], "argsInside": true},
            {"commands": ["goimports"], "argsInside": true},
            {"commands": ["make"], "targets": ["lint", "fmt", "test", "build"]},
            {
              "commands": ["git"],
              "check": "scopedGit",
              "summary": "read-only git (git diff|log|show must start --no-ext-diff --no-textconv), git add <paths>, git commit (no --amend, --no-verify, -n, -c/-C)"
            },
            {
              "commands": ["ls", "cat", "head", "tail", "wc", "grep", "rg", "diff", "cmp", "jq", "echo"],
              "bannedFlags": ["--pre"],
              "argsInside": true
            },
            {"commands": ["sort"], "bannedFlags": ["-o", "--output"], "argsInside": true},
            {"commands": ["cut", "mkdir"], "argsInside": true},
            {"commands": ["uniq"], "check": "uniqOneInput", "argsInside": true, "summary": "uniq (one input, no output file)"},
            {"commands": ["printf"], "check": "printfNoVar", "summary": "printf (no -v)"},
            {"commands": ["tr", "basename", "dirname", "pwd"]},
            {"commands": ["mktemp"], "bannedFlags": ["-p", "--tmpdir", "-t"], "check": "mktempInScope", "summary": "mktemp (template under $TMPDIR or the roots)"},
            {
              "commands": ["find"],
              "bannedFlags": ["-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprint0", "-fprintf", "-fls"],
              "argsInside": true
            },
            {"commands": ["claude-code"], "subcommands": ["test mutate", "network websearch", "workflow lint"]},
            {
              "commands": ["claude-code"],
              "subcommands": ["review"],
              "check": "noOutputFlag",
              "summary": "claude-code review (no -o/--output)"
            }
          ],
          "hookExtras": [
            {"commands": ["claude-code"], "subcommands": ["copilot", "worktree merge"]}
          ]
        }
      },
      "launch": {
        "args": [
          "--allow-all"
        ]
      }
    },
    "gemini": {
      "permission": {
        "useGuardRules": true
      },
      "launch": {
        "args": [
          "--dangerously-skip-permissions"
        ]
      }
    }
  }
}
