{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook access-trace",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook safety-scan",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook docs-placement",
            "timeout": 5,
            "statusMessage": "Checking doc placement"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook path-resolver",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook memory-recall",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
