{
  "$id": "claude-code/overlay.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "identity"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "const": "databricks"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "account"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "const": "github"
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "account": [
      "provider"
    ],
    "identity": [
      "provider"
    ],
    "profile": [
      "provider"
    ],
    "provider": [
      "profile"
    ]
  },
  "not": {
    "required": [
      "host",
      "remote"
    ]
  },
  "properties": {
    "account": {
      "minLength": 1,
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "agents": {
      "type": "object"
    },
    "appendSystemPrompt": {
      "type": "string"
    },
    "autonomous": {
      "type": "boolean"
    },
    "budgetCredits": {
      "minimum": 30,
      "type": "integer"
    },
    "budgetUSD": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "cloud": {
      "type": "boolean"
    },
    "codemode": {
      "enum": [
        "off",
        "on",
        "only"
      ],
      "type": "string"
    },
    "codexNetwork": {
      "type": "boolean"
    },
    "debugFile": {
      "type": "string"
    },
    "effort": {
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "enableMemory": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string"
    },
    "fallback": {
      "enum": [
        "none",
        "pin",
        "agents",
        "all"
      ]
    },
    "fence": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "type": "boolean"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "file": {
      "type": "string"
    },
    "fleet": {
      "type": "boolean"
    },
    "googleTools": {
      "pattern": "^(?:search|url|code)(?:, *(?:search|url|code))*$",
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "identity": {
      "enum": [
        "auto",
        "user",
        "sp"
      ]
    },
    "keep": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "maxChildren": {
      "type": "integer"
    },
    "maxDepth": {
      "type": "integer"
    },
    "maxTreeTokens": {
      "type": "integer"
    },
    "model": {
      "description": "plain id or alias; no \u003cprofile\u003e: prefix",
      "minLength": 1,
      "type": "string"
    },
    "native": {
      "type": "boolean"
    },
    "noPersist": {
      "type": "boolean"
    },
    "noTools": {
      "type": "boolean"
    },
    "outputSchema": {
      "type": "string"
    },
    "profile": {
      "description": "registry row or auto",
      "pattern": "^[^:\\s]+$",
      "type": "string"
    },
    "provider": {
      "enum": [
        "anthropic",
        "databricks",
        "github",
        "google",
        "magnitude",
        "openai"
      ]
    },
    "providerMode": {
      "additionalProperties": {
        "enum": [
          "rotate",
          "exclusive"
        ]
      },
      "type": "object"
    },
    "remote": {
      "type": "string"
    },
    "runner": {
      "enum": [
        "pi",
        "cli"
      ]
    },
    "schema": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "set": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "systemPrompt": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "fast",
        "standard",
        "deep"
      ],
      "type": "string"
    },
    "timeout": {
      "description": "Go duration, e.g. 9m30s",
      "pattern": "^(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))+$",
      "type": "string"
    },
    "tokenCommand": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "tools": {
      "type": "boolean"
    },
    "unset": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "claude-code dispatch overlay",
  "type": "object"
}
