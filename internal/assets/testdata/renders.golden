== WorkflowPipelineSkeleton ==
export const meta = {
  name: 'it\'s',
  description: 'Pipeline: each item through ordered stages, no barrier',
  phases: [{ title: 'Work' }, { title: 'Verify' }],
}

const ITEMS = args ?? []   // pass the work-list via Workflow `args`
const results = await pipeline(
  ITEMS,
  (item) => agent(`Do the work for: ${JSON.stringify(item)}`, {phase: 'Work', model: 'sonnet', effort: 'medium', schema: WORK_SCHEMA}),
  (work, item) => agent(`Adversarially verify: ${work.summary}`, {phase: 'Verify', model: 'sonnet', effort: 'medium', schema: VERDICT_SCHEMA})
    .then(v => ({...work, verdict: v})),
)
return results.filter(Boolean).filter(r => r.verdict?.ok)
== WorkflowParallelSkeleton ==
export const meta = {
  name: 'it\'s',
  description: 'Parallel fan-out with a barrier, then synthesize',
  phases: [{ title: 'Fan-out' }, { title: 'Synthesize' }],
}

const TASKS = args ?? []
phase('Fan-out')
const found = (await parallel(TASKS.map(t => () =>
  agent(`Investigate: ${JSON.stringify(t)}`, {model: 'sonnet', effort: 'medium', schema: FINDING_SCHEMA})))).filter(Boolean)
// Barrier justified: synthesis needs the FULL set (dedup/merge across all findings).
phase('Synthesize')
return await agent(`Synthesize these findings into one report: ${JSON.stringify(found)}`, {model: 'sonnet', effort: 'medium'})
== WorkflowEvaluatorSkeleton ==
export const meta = {
  name: 'it\'s',
  description: 'Generate, then adversarially verify before accepting',
  phases: [{ title: 'Generate' }, { title: 'Verify' }],
}

phase('Generate')
const draft = await agent('Produce the artifact.', {model: 'sonnet', effort: 'medium', schema: DRAFT_SCHEMA})
phase('Verify')
// N independent skeptics, each prompted to REFUTE; accept only if a majority can't.
const votes = (await parallel(['correctness', 'security', 'repro'].map(lens => () =>
  agent(`Try to refute the ${lens} of: ${draft.summary}. Default refuted=true if unsure.`,
        {model: 'sonnet', effort: 'medium', schema: VERDICT_SCHEMA})))).filter(Boolean)
const accepted = votes.filter(v => !v.refuted).length >= 2
return {draft, accepted, votes}
== WorkflowOrchestratorSkeleton ==
export const meta = {
  name: 'it\'s',
  description: 'Planner decomposes, then pipeline over the work-list',
  phases: [{ title: 'Plan' }, { title: 'Build' }],
}

phase('Plan')
// Discover the work-list at runtime, then fan out over it (don't hardcode the shape).
const plan = await agent(`Break down this goal into parallel-safe tasks: ${args?.goal ?? ''}`,
                         {model: 'sonnet', effort: 'medium', schema: PLAN_SCHEMA})
phase('Build')
// isolation:'worktree' ONLY if tasks mutate files in parallel (else drop it — it's expensive).
const done = await pipeline(
  plan.tasks,
  (task) => agent(task.brief, {phase: 'Build', isolation: 'worktree', model: 'sonnet', effort: 'medium', schema: RESULT_SCHEMA}),
  (result) => agent(`Review for spec + quality: ${result.summary}`, {phase: 'Build', model: 'sonnet', effort: 'medium', schema: REVIEW_SCHEMA})
    .then(r => ({...result, review: r})),
)
return done.filter(Boolean)
== BenchFixBrief (rtk) ==
Owned: own
Mode: implementation; edit only owned files
Verify: ver

Task:
Make BenchX in pkg perform the same work faster; hand back uncommitted with before/after numbers.
Work in the lane /w. Candidate cause (a hypothesis to verify): cause

## Measurement evidence

1ns

Before run file: /b
Read that evidence before editing. Measure the unchanged code and the fix with the same command and inputs:

```bash
cd '/w'
go test
```

Record ns/op, B/op, allocs/op and any spawn counts available, sample count, noise, and the numeric before/after delta.
Defer when the machine is busy; a noisy run cannot establish a win. The driver performs the final interleaved A/B run.

## Preserve behaviour

Reduce allocations, use independent concurrency, consider caching, or make fewer spawns; never skip or drop a validation.
Never remove any check, error path, cancellation, ordering guarantee, or required work to improve a benchmark.
Caching requires owner approval before KEEP, even if outputs appear identical; report freshness and invalidation.
Keep all benchmark files and *_test.go unchanged: editing them changes the epoch and invalidates the comparison.
Do not edit, rewrite, replace, or delete benchmarks; D6 requires owner approval for every deletion batch.
If a safe fix needs files outside Owned, stop and report the blocker.

## Verification

Format only owned Go files, then lint; live-check output identity before scoped tests:

```bash
cd '/w'
go vet 'pkg'
id
ver
rtk git diff --no-ext-diff --no-textconv HEAD
```

Check successful and failing inputs, errors, side effects, and cancellation against the parent, not just timing.
Inspect the entire lane diff for ownership and unchanged benchmarks. Run Skill(simplify) over your changes.

## Leaf rules

- Never revert a change you did not make; no git commit, stash, checkout, reset, restore, switch, merge, or push.
- Edit only the named production files with Edit or Write, never a splice script, sed -i, perl -pi, or shell heredoc.
- Report compile errors in unowned files; do not fix them. Do not add tests or modify existing tests in this fix lane.
- Never wipe or rewrite the dispatch environment, print credentials, use sudo, or delete outside scratch directories.
- Never use foreground sleep; use background work and its completion notification.
- Shell output uses rtk; use rtk read for files and rtk bypass when exact bytes matter. go vet stays bare.
- Run scoped checks only, never the full suite. Fix leaves use Databricks with the harness's R6 model mix.
- Hand back uncommitted. D1 reserves commits for the driver in lanes only; never commit on main or merge a lane.
- Do not record a KEEP or advance rolling.txt; the driver owns decisions and baseline promotion after merge.

## Reporting contract

Return the full report in your final answer, opening with DONE, DONE_WITH_CONCERNS, or BLOCKED.
Include absolute files with numstat, commands and exit codes, before/after numbers, output-identity evidence,
checks preserved, cache/concurrency risks, gross production lines added/deleted, and anything blocked.
Name the unchanged benchmark epoch evidence and what the driver needs for its interleaved run and Opus review.

