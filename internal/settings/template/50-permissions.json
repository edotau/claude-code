{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)",
      "Bash(go *)",
      "Bash(claude-code *)",
      "Bash(gofmt -l *)",
      "Bash(systemctl --user is-active *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest *)",
      "Bash(npm *)",
      "Bash(npx vitest *)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)"
    ]
  }
}
