{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build ./...)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run ./...)",
      "Bash(claude-code worktree list *)",
      "Bash(claude-code vault list *)",
      "Bash(claude-code databricks check *)",
      "Bash(claude-code agents tree *)",
      "Bash(claude-code configure provider --list *)",
      "Bash(oc get *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run --coverage)",
      "Bash(npm run e2e:*)",
      "Bash(npx cypress run:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/env.d/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)",
      "Bash(security add-generic-password:*)",
      "Bash(security delete-generic-password:*)"
    ]
  }
}
