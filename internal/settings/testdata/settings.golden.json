{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "outputStyle": "Concise",
  "switchModelsOnFlag": true,
  "theme": "auto",
  "tui": "default",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "preferredNotifChannel": "notifications_disabled",
  "awaySummaryEnabled": false,
  "feedbackDrafts": "off",
  "cleanupPeriodDays": 30,
  "autoConnectIde": false,
  "useAutoModeDuringPlan": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(*)",
      "Read(*)",
      "Write(*)",
      "Agent",
      "WebFetch(*)",
      "Bash(go *)",
      "Bash(claude-code *)",
      "Bash(gofmt -l *)",
      "Bash(systemctl --user is-active *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(make test:*)",
      "Bash(make audit:*)",
      "Bash(make verify:*)",
      "Bash(go test ./...:*)",
      "Bash(pytest *)",
      "Bash(npm *)",
      "Bash(npx vitest *)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/env.d/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight-tag",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook plan-mirror",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook save-plan",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook access-trace",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight-post",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook pre-compact",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook bash-guard",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook docs-placement",
            "timeout": 5,
            "statusMessage": "Checking doc placement"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-effort",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook workflow-lint",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook session-harvest-end",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook session-start",
            "timeout": 10,
            "statusMessage": "Loading session memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook stop",
            "timeout": 50
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook wsl-path-normalize",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook memory-recall",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook worktree-create",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook worktree-remove",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
