{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "env": {
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "300000",
    "CLAUDE_CODE_SCROLL_SPEED": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/env.d/secrets.env)",
      "Read(**/.credentials.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code statusline",
    "padding": 0
  },
  "model": "fable",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "theme": "auto",
  "tui": "fullscreen",
  "feedbackDrafts": "off",
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": true,
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "impeccable@impeccable": true,
    "databricks@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight-tag",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook save-plan",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook access-trace",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight-post",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook safety",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook rtk-wrap",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook docs-placement",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-effort",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook agent-inflight",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook session-harvest-end",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook context-checkpoint",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook stop-format",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook session-harvest",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/claude-code hook memory-recall",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
