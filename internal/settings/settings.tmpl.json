{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "prefersReducedMotion": true,
  "spinnerTipsEnabled": false,
  "env": {
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "300000",
    "CLAUDE_CODE_SCROLL_SPEED": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/env.d/**)",
      "Read(**/state/vault.db)",
      "Read(**/.credentials.json)",
      "Bash(security add-generic-password:*)",
      "Bash(security delete-generic-password:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${HOOK_BIN} statusline",
    "padding": 0
  },
  "model": "fable",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "theme": "auto",
  "tui": "default",
  "feedbackDrafts": "off",
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": true,
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "impeccable@impeccable": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
