{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/slash-usage"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Read",
      "Write",
      "WebFetch(*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Edit(~/.ssh/**)",
      "Edit(**/state/vault.db)",
      "Edit(**/.credentials.json)",
      "Edit(~/.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  }
}
