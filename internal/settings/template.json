{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/slash-usage"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Read(~/.claude/state/vault.db)",
      "WebFetch(*)",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf ~)",
      "Bash(sudo:*)",
      "Edit(~/.ssh/**)"
    ],
    "ask": [
      "Edit(**/.credentials.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/state/vault.db)",
      "Read(~/.ssh/id_*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  }
}
