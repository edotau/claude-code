{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/slash-usage:~/.claude/mods/agents-band"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Read(~/.ssh/**)",
      "Read(**/state/vault.db)",
      "Edit(~/.ssh/**)",
      "Edit(**/state/vault.db)",
      "Edit(**/.credentials.json)",
      "Edit(~/.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(~/.ssh/**)",
      "Edit(~/.claude/internal/agentconfig/agents.json)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/bin/claude-code theme statusline",
    "padding": 0
  }
}
