{
  "default": "max",
  "fallback": [],
  "routing": {
    "weights": {
      "price": 0.5,
      "headroom": 0.5
    },
    "subagents": true,
    "opencode": {
      "ladder": [
        "opencode-go",
        "github-copilot",
        "openai"
      ],
      "workRepoMarkers": [],
      "freeTiers": [
        "sonnet",
        "haiku"
      ],
      "freeFirstOutput": "90s"
    }
  },
  "providers": {
    "anthropic": {
      "max": {
        "protocol": "anthropic",
        "base_url": "https://api.anthropic.com",
        "auth": {
          "type": "cli"
        },
        "models": {
          "opus": "claude-opus-5-5",
          "sonnet": "claude-sonnet-5-5",
          "haiku": "claude-haiku-5-5",
          "fable": "claude-fable-5-1"
        }
      },
      "anthropic": {
        "protocol": "anthropic",
        "base_url": "https://api.anthropic.com",
        "auth": {
          "type": "key",
          "env": "ANTHROPIC_API_KEY"
        },
        "models": {
          "opus": "claude-opus-5-5",
          "sonnet": "claude-sonnet-5-5",
          "haiku": "claude-haiku-5-5",
          "fable": "claude-fable-5-1"
        }
      }
    },
    "github": {
      "personal": {
        "protocol": "openai",
        "base_url": "https://api.githubcopilot.com",
        "auth": {
          "type": "cli",
          "login": "copilot"
        },
        "models": {
          "opus": "auto",
          "sonnet": "auto",
          "haiku": "auto"
        },
        "opencode_fallback": "claude-opus-5.5",
        "opencode_variant": "medium",
        "opencodeID": "github-copilot"
      }
    },
    "openai": {
      "chatgpt": {
        "protocol": "responses",
        "base_url": "https://chatgpt.com/backend-api/codex",
        "auth": {
          "type": "cli",
          "login": "codex"
        },
        "models": {
          "opus": "gpt-6.1-sol",
          "sonnet": "gpt-6.1-sol",
          "haiku": "gpt-6-luna"
        },
        "opencodeID": "openai"
      },
      "openai": {
        "protocol": "openai",
        "base_url": "https://api.openai.com/v1",
        "routes": {
          "responses": "https://api.openai.com/v1"
        },
        "auth": {
          "type": "key",
          "env": "OPENAI_API_KEY"
        },
        "models": {
          "opus": "gpt-5",
          "sonnet": "gpt-5-mini",
