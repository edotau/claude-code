<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="csrf-token" content="{{.CSRFToken}}">
<title>claude-code web</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0.75rem; font: 15px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #300a24; color: #c0c0c0;
  }
  h1 { font-size: 1.1rem; margin: 0.25rem 0 0.75rem; }
  h2 { font-size: 0.95rem; color: #a89fa6; margin: 1.25rem 0 0.4rem; text-transform: uppercase; letter-spacing: 0.04em; }
  section { margin-bottom: 1rem; }
  .card { background: #3d1431; border: 1px solid #40404055; border-radius: 10px; padding: 0.6rem 0.75rem; margin-bottom: 0.5rem; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  .muted { color: #8f8a8d; font-size: 0.82rem; }
  .chip { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }
  .chip-running, .chip-active, .chip-working { background: #1d3a0a; color: #8ae234; }
  .chip-finished, .chip-idle, .chip-ready { background: #46183a; color: #c0c0c0; }
  .chip-stale, .chip-error { background: #4a1010; color: #ef2929; }
  .chip-input-needed { background: #4a3d00; color: #fce94f; }
  .chip-unknown, .chip-gone { background: #2a081f; color: #8f8a8d; }
  .sub { margin-left: 0.9rem; border-left: 2px solid #40404055; padding-left: 0.6rem; margin-top: 0.35rem; }
  .agent-row { cursor: pointer; padding: 0.2rem 0; }
  .agent-row:hover { background: #46183a; }
  .activity { font-size: 0.78rem; color: #729fcf; margin-top: 0.1rem; }
  .leg { font-size: 0.78rem; margin: 0.1rem 0 0 0.5rem; color: #a89fa6; }
  .linklike { background: none; border: none; color: #729fcf; width: auto; padding: 0; margin: 0; font-weight: 400; cursor: pointer; }
  #detailEvents { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.78rem; max-height: 40vh; overflow: auto; margin: 0.4rem 0 0; }
  label { display: block; font-size: 0.82rem; color: #a89fa6; margin: 0.5rem 0 0.2rem; }
  select, input, textarea, button {
    width: 100%; padding: 0.5rem; border-radius: 8px; border: 1px solid #40404055;
    background: #2a081f; color: #c0c0c0; font-size: 0.95rem;
  }
  textarea { min-height: 4.5rem; resize: vertical; }
  button { margin-top: 0.75rem; background: #E95420; border-color: #E95420; color: #fff; font-weight: 600; cursor: pointer; }
  button:disabled { opacity: 0.6; }
  #dispatchResult { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.8rem; margin-top: 0.5rem; }
  #hostTabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  #hostTabs button { width: auto; background: #46183a; border-color: #40404055; color: #c0c0c0; font-weight: 400; margin-top: 0; padding: 0.3rem 0.6rem; }
  #hostTabs button.active { background: #E95420; border-color: #E95420; color: #fff; }
  #tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  #tabs button { width: auto; margin-top: 0; padding: 0.3rem 0.8rem; background: #46183a; border-color: #40404055; color: #c0c0c0; font-weight: 400; }
  #tabs button.active { background: #E95420; border-color: #E95420; color: #fff; }
  #usageDays button { width: auto; margin-top: 0; padding: 0.2rem 0.7rem; background: #46183a; border-color: #40404055; color: #c0c0c0; font-weight: 400; }
  #usageDays button.active { background: #E95420; border-color: #E95420; color: #fff; }
  .bar { height: 6px; background: #40404055; border-radius: 3px; margin: 0.35rem 0 0.2rem; overflow: hidden; }
  .bar > span { display: block; height: 100%; background: #8ae234; }
  .plan-row { cursor: pointer; }
  .task { margin: 0.25rem 0; }
  .task code { background: #2a081f; padding: 0 0.3rem; border-radius: 4px; cursor: pointer; }
  #planMd { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.78rem; max-height: 50vh; overflow: auto; margin: 0.4rem 0 0; }
  /* The --vscode-* variables the shared usage-view.js reads; copied into its iframe. Ubuntu terminal palette, dark only. */
  :root {
    --vscode-foreground: #c0c0c0; --vscode-sideBar-background: #300a24; --vscode-descriptionForeground: #8f8a8d;
    --vscode-widget-border: #40404055; --vscode-button-background: #E95420; --vscode-button-foreground: #ffffff;
    --vscode-badge-background: #5f5961; --vscode-badge-foreground: #ffffff; --vscode-charts-blue: #729fcf;
    --vscode-charts-green: #8ae234; --vscode-charts-orange: #E95420; --vscode-charts-yellow: #fce94f;
    --vscode-editorWarning-foreground: #fce94f; --vscode-editorError-foreground: #ef2929;
    --vscode-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  #architecturePane { overflow-wrap: anywhere; }
  .arch-subtabs { display: flex; flex-wrap: wrap; gap: 0 1rem; margin-bottom: 0.7rem; border-bottom: 1px solid #40404088; }
  .arch-subtabs button { width: auto; margin: 0 0 -1px; padding: 0.3rem 0.1rem; background: none; border: 0; border-bottom: 2px solid transparent; border-radius: 0; color: #a89fa6; font-weight: 400; font-size: 0.82rem; }
  .arch-subtabs button.active { border-bottom-color: #E95420; color: #fff; }
  .arch-sec h3 { font-size: 0.9rem; color: #a89fa6; margin: 1rem 0 0.4rem; }
  .arch-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.25rem 0; }
  .arch-chip { width: auto; margin: 0; padding: 0.1rem 0.5rem; background: #46183a; border: 1px solid #40404055; border-radius: 999px; color: #c0c0c0; font-size: 0.75rem; font-weight: 400; text-align: left; overflow-wrap: anywhere; }
  .arch-badge { display: inline-block; padding: 0.05rem 0.45rem; border: 1px solid #40404055; border-radius: 999px; background: #2a081f; font-size: 0.72rem; color: #c0c0c0; }
  .arch-badge.sev-critical { background: #4a1010; color: #ef2929; }
  .arch-badge.sev-high { background: #4a2a00; color: #E95420; }
  .arch-badge.sev-medium { background: #4a3d00; color: #fce94f; }
  .arch-badge.sev-low { background: #1d3a0a; color: #8ae234; }
  .arch-band { margin-bottom: 0.4rem; }
  .arch-dir { background: #3d1431; border: 1px solid #40404055; border-radius: 10px; padding: 0.4rem 0.6rem; margin-bottom: 0.35rem; }
  .arch-sum { cursor: pointer; }
  .arch-path { font-family: ui-monospace, monospace; font-size: 0.82rem; color: #fff; }
  .arch-purpose { display: block; font-size: 0.8rem; color: #a89fa6; }
  .arch-detail, .arch-sub { margin-top: 0.4rem; font-size: 0.84rem; }
  .arch-field { margin: 0.2rem 0; }
  .arch-flags { display: flex; flex-wrap: wrap; gap: 0.1rem 0.7rem; color: #a89fa6; font-family: ui-monospace, monospace; font-size: 0.76rem; }
  .arch-flags span { white-space: nowrap; }
  .arch-body ul { padding-left: 1.1rem; margin: 0.3rem 0; }
  #usageFrame { width: 100%; min-height: 320px; height: 70vh; border: 1px solid var(--vscode-widget-border); border-radius: 10px; }
</style>
</head>
<body>
<h1>claude-code web</h1>
<div id="tabs">
  <button type="button" data-tab="agents" class="active">Agents</button>
  <button type="button" data-tab="plans">Plans</button>
  <button type="button" data-tab="usage">Usage</button>
  <button type="button" data-tab="architecture">Architecture</button>
</div>

<div id="architecturePane" style="display:none"></div>

<div id="usagePane" style="display:none">
  <p class="muted"><span id="usageDays"><button type="button" data-days="7">7d</button> <button type="button" data-days="30">30d</button></span> <span id="usageStatus">loading…</span></p>
  <iframe id="usageFrame" sandbox="allow-scripts" title="Usage" hidden></iframe>
</div>

<div id="plansPane" style="display:none">
  <section>
    <h2>Plans</h2>
    <div id="plansList"><p class="muted">loading…</p></div>
  </section>
  <section id="planSection" style="display:none">
    <h2>Plan <button type="button" class="linklike" id="planCloseBtn">[close]</button></h2>
    <div id="planDetail"></div>
  </section>
</div>

<div id="agentsPane">
<section>
  <h2>Agents</h2>
  <div id="tree"><p class="muted">loading…</p></div>
</section>

<section id="detailSection" style="display:none">
  <h2>Agent <button type="button" class="linklike" id="detailCloseBtn">[close]</button></h2>
  <div id="detail"></div>
</section>

<section>
  <h2>Browsers</h2>
  <div id="browsers"><p class="muted">loading…</p></div>
</section>

<section>
  <h2>Dispatches</h2>
  <div id="hostTabs"></div>
  <div id="dispatches"><p class="muted">select a host</p></div>
</section>

<section>
  <h2>Dispatch</h2>
  <form id="dispatchForm">
    <label for="f-host">Host</label>
    <select id="f-host" name="host">
      {{range .Hosts}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>

    <label for="f-agent">Agent</label>
    <select id="f-agent" name="agent">
      {{range .Agents}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>

    <label for="f-dir">Directory</label>
    <input id="f-dir" name="dir" placeholder="~/project">

    <label for="f-task">Task</label>
    <textarea id="f-task" name="task" placeholder="What should the agent do?" required></textarea>

    <button type="submit">Dispatch</button>
  </form>
  <div id="dispatchResult"></div>
</section>
</div>

<script>
const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
let currentHost = null;

function escapeHTML(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function chip(status) {
  return '<span class="chip chip-' + escapeHTML(status) + '">' + escapeHTML(status) + '</span>';
}

// statusGlyph mirrors internal/agenttree/render.go's statusGlyph: one marker per status at a glance.
function statusGlyph(status) {
  return { running: '●', finished: '✓', error: '✗', stale: '·' }[status] || ' ';
}

function renderActivity(a) {
  if (!a || (!a.tool && !a.text)) return '';
  const text = a.tool ? (a.tool + (a.arg ? ' ' + a.arg : '')) : a.text;
  return '<div class="activity">' + escapeHTML(text) + '</div>';
}

// renderLeg mirrors internal/agenttree/render.go's formatLeg: "↳ codex gpt-6-astra running 2m14s".
function renderLeg(l) {
  const name = l.fallback ? escapeHTML(l.fallback) + '→' + escapeHTML(l.agent) : escapeHTML(l.agent);
  let line = '↳ ' + name + ' ' + escapeHTML(l.model || '') + ' ' + chip(l.status) + ' ' + escapeHTML(l.duration || '');
  if (l.fallback) line += ' ⚠ fallback';
  return '<div class="leg">' + line + '</div>';
}

function renderSubagents(subs, sessionId) {
  if (!subs || !subs.length) return '';
  return '<div class="sub">' + subs.map(function (s) {
    return '<div class="agent-row" data-session="' + escapeHTML(sessionId) + '" data-agent="' + escapeHTML(s.id) + '">' +
      '<div class="row"><span>' + statusGlyph(s.status) + ' ' + escapeHTML(s.type || s.id) + ' ' + chip(s.status) + '</span>' +
      '<span class="muted">' + escapeHTML(s.lastTool || '') + '</span></div>' +
      renderActivity(s.activity) +
      (s.legs || []).map(renderLeg).join('') +
      '</div>';
  }).join('') + '</div>';
}

// phaseDone mirrors internal/agenttree/render.go's phaseDone: agents with a finished/error result vs. total.
function phaseDone(agents) {
  let done = 0;
  (agents || []).forEach(function (a) { if (a.status === 'finished' || a.status === 'error') done++; });
  return done;
}

function renderWorkflows(runs, sessionId) {
  if (!runs || !runs.length) return '';
  return '<div class="sub">' + runs.map(function (run) {
    return '<div class="card"><div class="row"><span>workflow ' + escapeHTML(run.name || run.id) + ' ' + chip(run.status) + '</span></div>' +
      (run.phases || []).map(function (phase) {
        const total = (phase.agents || []).length;
        return '<div class="muted">phase ' + escapeHTML(phase.name) + ' (' + phaseDone(phase.agents) + '/' + total + ' done)</div>' +
          renderSubagents(phase.agents, sessionId);
      }).join('') +
      '</div>';
  }).join('') + '</div>';
}

function renderTree(tree) {
  const sessions = tree.sessions || [];
  if (!sessions.length) return '<p class="muted">no recent sessions</p>';
  return sessions.map(function (s) {
    return '<div class="card">' +
      '<div class="row"><strong>' + escapeHTML(s.title || s.project || s.id) + '</strong>' + chip(s.status) + '</div>' +
      '<div class="muted">' + escapeHTML(s.cwd || '') + (s.branch ? ' @' + escapeHTML(s.branch) : '') + '</div>' +
      renderSubagents(s.subagents, s.id) +
      renderWorkflows(s.workflows, s.id) +
      '</div>';
  }).join('');
}

function renderDispatches(statuses) {
  if (!statuses || !statuses.length) return '<p class="muted">no cc-* panes</p>';
  return statuses.map(function (p) {
    return '<div class="card"><div class="row"><strong>' + escapeHTML(p.session) + '</strong>' +
      chip(p.state) + '</div>' +
      '<div class="muted">' + escapeHTML(p.agent || '') + ' &middot; ' + escapeHTML(p.reason || '') + '</div></div>';
  }).join('');
}

// eventLine mirrors internal/agenttree/view.go's formatEvent for one Snapshot.Events entry.
function eventLine(e) {
  const ts = e.at ? new Date(e.at).toLocaleTimeString() : '';
  if (e.kind === 'tool') return ts + ' tool ' + (e.tool || '') + ' ' + (e.arg || '');
  if (e.kind === 'text') return ts + ' text "' + (e.text || '') + '"';
  if (e.kind === 'result') return ts + ' result ' + (e.size || 0) + ' B';
  return ts;
}

function renderSnapshot(snap) {
  let html = '<div class="row"><strong>' + escapeHTML(snap.label || snap.id) + '</strong>' + chip(snap.status) + '</div>';
  if (snap.workflow) html += '<div class="muted">workflow ' + escapeHTML(snap.workflow) + ' phase ' + escapeHTML(snap.phase || '') + '</div>';
  html += '<div class="muted">' + escapeHTML(snap.model || '') + (snap.effort ? ' effort=' + escapeHTML(snap.effort) : '') + '</div>';
  html += renderActivity(snap.activity);
  (snap.filesEdited || []).forEach(function (f) { html += '<div class="muted">edited ' + escapeHTML(f) + '</div>'; });
  (snap.legs || []).forEach(function (l) { html += renderLeg(l); });
  if (snap.result) html += '<div class="muted">result: ' + escapeHTML(snap.result) + '</div>';
  const lines = (snap.events || []).map(eventLine).join('\n');
  html += '<pre id="detailEvents">' + escapeHTML(lines) + '</pre>';
  return html;
}

function closeDetail() {
  if (window._detailAbort) window._detailAbort.abort();
  document.getElementById('detailSection').style.display = 'none';
  document.getElementById('detail').innerHTML = '';
}

// followDetail streams /api/view?follow=1's text/plain lines into #detailEvents as they arrive,
// aborted by closeDetail or by opening a different agent.
function followDetail(sessionId, agentId) {
  const controller = new AbortController();
  window._detailAbort = controller;
  fetch('/api/view?session=' + encodeURIComponent(sessionId) + '&agent=' + encodeURIComponent(agentId) + '&follow=1', { signal: controller.signal })
    .then(function (r) {
      const reader = r.body.getReader();
      const decoder = new TextDecoder();
      const pre = document.getElementById('detailEvents');
      function pump() {
        return reader.read().then(function (res) {
          if (res.done || !pre) return;
          pre.textContent += decoder.decode(res.value, { stream: true });
          return pump();
        });
      }
      return pump();
    })
    .catch(function () {});
}

function openDetail(sessionId, agentId) {
  if (window._detailAbort) window._detailAbort.abort();
  const section = document.getElementById('detailSection');
  const el = document.getElementById('detail');
  section.style.display = '';
  el.innerHTML = '<p class="muted">loading…</p>';
  fetch('/api/view?session=' + encodeURIComponent(sessionId) + '&agent=' + encodeURIComponent(agentId))
    .then(function (r) {
      if (!r.ok) return r.text().then(function (t) { throw new Error(t); });
      return r.json();
    })
    .then(function (snap) {
      el.innerHTML = renderSnapshot(snap);
      if (snap.status === 'running') followDetail(sessionId, agentId);
    })
    .catch(function (err) { el.innerHTML = '<p class="muted">' + escapeHTML(String(err.message || err)) + '</p>'; });
}

function renderBrowsers(rep) {
  const browsers = (rep && rep.browsers) || [];
  if (!browsers.length) return '<p class="muted">no browsers detected</p>';
  return browsers.map(function (b) {
    const paths = b.paths || {};
    const mark = b.default ? ' <span class="muted">(default)</span>' : '';
    return '<div class="card"><div class="row"><strong>' + escapeHTML(b.displayName || b.name) + '</strong>' + mark + '</div>' +
      '<div class="muted">host=' + escapeHTML(b.host || '') + ' extension=' + escapeHTML(paths.extension || '') +
      ' cdp=' + escapeHTML(paths.cdp || '') + ' webdriver=' + escapeHTML(paths.webdriver || '') +
      ' gui=' + escapeHTML(paths.gui || '') + '</div></div>';
  }).join('');
}

function loadBrowsers() {
  fetch('/api/browsers').then(function (r) { return r.json(); }).then(function (rep) {
    document.getElementById('browsers').innerHTML = renderBrowsers(rep);
  }).catch(function () {});
}

let treeEpoch = 0; // bumped per SSE render; a fetch that began before one is stale and must not overwrite it
function loadTree() {
  const started = treeEpoch;
  fetch('/api/tree').then(function (r) { return r.json(); }).then(function (tree) {
    if (treeEpoch !== started) return;
    document.getElementById('tree').innerHTML = renderTree(tree);
  }).catch(function () {});
}

function loadDispatches(host) {
  if (!host) return;
  fetch('/api/dispatches?host=' + encodeURIComponent(host)).then(function (r) { return r.json(); }).then(function (sessions) {
    document.getElementById('dispatches').innerHTML = renderDispatches(sessions);
  }).catch(function () {});
}

function buildHostTabs(hosts) {
  const el = document.getElementById('hostTabs');
  el.innerHTML = hosts.map(function (h) { return '<button data-host="' + escapeHTML(h) + '">' + escapeHTML(h) + '</button>'; }).join('');
  el.querySelectorAll('button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      el.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      currentHost = btn.dataset.host;
      loadDispatches(currentHost);
    });
  });
  if (hosts.length) {
    currentHost = hosts[0];
    el.querySelector('button').classList.add('active');
    loadDispatches(currentHost);
  }
}

document.getElementById('dispatchForm').addEventListener('submit', function (e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button');
  btn.disabled = true;
  const body = new URLSearchParams(new FormData(form));
  fetch('/api/dispatch', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrfToken },
    body: body.toString(),
  }).then(function (r) { return r.text().then(function (t) { return { ok: r.ok, text: t }; }); })
    .then(function (res) {
      document.getElementById('dispatchResult').textContent = res.text;
      if (res.ok && currentHost) loadDispatches(currentHost);
    }).catch(function (err) {
      document.getElementById('dispatchResult').textContent = String(err);
    }).finally(function () { btn.disabled = false; });
});

document.getElementById('tree').addEventListener('click', function (e) {
  const row = e.target.closest('.agent-row');
  if (!row) return;
  openDetail(row.dataset.session, row.dataset.agent);
});
document.getElementById('detailCloseBtn').addEventListener('click', closeDetail);

let treeLive = false;
function watchTree() {
  if (!window.EventSource) return;
  const es = new EventSource('/api/events');
  es.addEventListener('tree', function (e) {
    try { const t = JSON.parse(e.data); treeEpoch++; document.getElementById('tree').innerHTML = renderTree(t); treeLive = true; } catch (err) {}
  });
  es.addEventListener('plans', function (e) {
    try { plansLive = true; renderPlans(JSON.parse(e.data)); if (openPlan) showPlan(openPlan); } catch (err) {}
  });
  es.onerror = function () { treeLive = false; plansLive = false; es.close(); };
}

let plansList = [];
let openPlan = null;
let plansLive = false;
function loadPlans() {
  fetch('/api/plans').then(function (r) { return r.json(); })
    .then(function (l) { renderPlans(l); if (openPlan) showPlan(openPlan); }).catch(function () {});
}
function el(tag, cls, text) {
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text != null) n.textContent = text;
  return n;
}

function renderPlans(list) {
  plansList = list || [];
  const box = document.getElementById('plansList');
  box.textContent = '';
  if (!plansList.length) { box.appendChild(el('p', 'muted', 'no plans')); return; }
  const byRepo = new Map();
  plansList.forEach(function (p) { if (!byRepo.has(p.repo)) byRepo.set(p.repo, []); byRepo.get(p.repo).push(p); });
  Array.from(byRepo.keys()).sort().forEach(function (repo) {
    box.appendChild(el('h2', null, repo));
    byRepo.get(repo).forEach(function (p) {
      const card = el('div', 'card plan-row');
      const row = el('div', 'row');
      row.appendChild(el('strong', null, p.path.split('/').pop()));
      const note = p.ticked + '/' + p.total + (p.claims.length ? ' · ' + p.claims.length + ' claimed' : '');
      row.appendChild(el('span', 'muted', note));
      card.appendChild(row);
      const bar = el('div', 'bar');
      const fill = document.createElement('span');
      fill.style.width = (p.total ? Math.round(100 * p.ticked / p.total) : 0) + '%';
      bar.appendChild(fill);
      card.appendChild(bar);
      card.addEventListener('click', function () { showPlan(p.path); });
      box.appendChild(card);
    });
  });
}

function renderPlanDetail(d) {
  const box = document.getElementById('planDetail');
  box.textContent = '';
  box.appendChild(el('div', 'muted', d.path));
  d.tasks.forEach(function (t) {
    const row = el('div', 'task');
    row.appendChild(document.createTextNode((t.done ? '☑ ' : '☐ ') + (t.id ? t.id + ' ' : '') + t.title + ' '));
    if (t.sha) {
      const code = el('code', null, t.sha);
      code.title = 'copy';
      code.addEventListener('click', function () { if (navigator.clipboard) navigator.clipboard.writeText(t.sha).catch(function () {}); });
      row.appendChild(code);
    }
    if (t.claim) row.appendChild(el('div', 'activity', 'claim: ' + t.claim));
    t.partial.forEach(function (n) { row.appendChild(el('div', 'activity', 'partly landed: ' + n)); });
    box.appendChild(row);
  });
  box.appendChild(el('pre', null, d.markdown)).id = 'planMd';
}

function showPlan(path) {
  openPlan = path;
  document.getElementById('planSection').style.display = '';
  fetch('/api/plan?path=' + encodeURIComponent(path))
    .then(function (r) { if (!r.ok) return r.text().then(function (t) { throw new Error(t); }); return r.json(); })
    .then(function (d) { if (openPlan === path) renderPlanDetail(d); })
    .catch(function (err) {
      const box = document.getElementById('planDetail');
      box.textContent = '';
      box.appendChild(el('p', 'muted', String(err.message || err)));
    });
}

document.getElementById('planCloseBtn').addEventListener('click', function () {
  openPlan = null;
  document.getElementById('planSection').style.display = 'none';
});

// Usage tab: the vscode extension's CommonJS modules (served from /assets/usage/) behind a minimal require shim.
const USAGE_MODULES = ['format', 'pricing', 'usage-model', 'usage-view'];
const USAGE_VARS = ['foreground', 'sideBar-background', 'descriptionForeground', 'widget-border', 'button-background',
  'button-foreground', 'badge-background', 'badge-foreground', 'charts-blue', 'charts-green', 'charts-orange',
  'charts-yellow', 'editorWarning-foreground', 'editorError-foreground', 'font-family'];
const usageState = { json: null, show: 'used', detailed: true, days: 7, mods: null };

function loadUsageModules() {
  if (usageState.mods) return usageState.mods;
  usageState.mods = Promise.all(USAGE_MODULES.map(function (n) {
    return fetch('/assets/usage/' + n + '.js').then(function (r) {
      if (!r.ok) throw new Error(n + '.js: HTTP ' + r.status);
      return r.text();
    });
  })).then(function (srcs) {
    const cache = {};
    function req(id) {
      const i = USAGE_MODULES.indexOf(id.replace(/^\.\//, ''));
      if (i < 0) throw new Error('unknown module ' + id);
      if (!cache[i]) {
        const m = cache[i] = { exports: {} };
        new Function('require', 'module', 'exports', srcs[i])(req, m, m.exports);
      }
      return cache[i].exports;
    }
    return { model: req('usage-model'), view: req('usage-view') };
  });
  return usageState.mods;
}

function usageThemeCSS() {
  const cs = getComputedStyle(document.documentElement);
  return ':root{color-scheme:' + cs.colorScheme + ';' + USAGE_VARS.map(function (v) {
    return '--vscode-' + v + ':' + cs.getPropertyValue('--vscode-' + v) + ';';
  }).join('') + '}';
}

function renderUsage() {
  if (!usageState.json) return;
  loadUsageModules().then(function (m) {
    const nonce = Array.from(crypto.getRandomValues(new Uint8Array(12)), function (b) { return b.toString(16).padStart(2, '0'); }).join('');
    const model = m.model.buildUsageModel(usageState.json, null, Date.now());
    const html = m.view.renderUsageHtml(model, { detailed: usageState.detailed, show: usageState.show, days: usageState.days, nonce: nonce });
    const bridge = '<style>' + usageThemeCSS() + '</style><script nonce="' + nonce + '">' +
      'window.acquireVsCodeApi=function(){return{postMessage:function(m){parent.postMessage(m,"*")}}};' +
      'new ResizeObserver(function(){parent.postMessage({type:"height",h:document.body.scrollHeight},"*")}).observe(document.body);' +
      '<\/script>';
    const frame = document.getElementById('usageFrame');
    frame.srcdoc = html.replace('<head>', '<head>' + bridge);
    frame.hidden = false;
    document.getElementById('usageStatus').textContent = '';
  }).catch(function (err) {
    document.getElementById('usageStatus').textContent = 'usage render failed: ' + err.message;
  });
}

function loadUsage(fresh) {
  const status = document.getElementById('usageStatus');
  status.textContent = 'loading…';
  fetch('/api/usage?days=' + usageState.days + (fresh ? '&fresh=1' : '')).then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }).then(function (j) { usageState.json = j; renderUsage(); })
    .catch(function (err) { status.textContent = 'usage unavailable: ' + err.message; });
}

function markUsageDays() {
  document.querySelectorAll('#usageDays button').forEach(function (b) {
    b.classList.toggle('active', Number(b.dataset.days) === usageState.days);
  });
}

document.getElementById('usageDays').addEventListener('click', function (e) {
  const d = Number(e.target.dataset && e.target.dataset.days);
  if (!d || d === usageState.days) return;
  usageState.days = d;
  markUsageDays();
  loadUsage(false);
});
markUsageDays();

window.addEventListener('message', function (e) {
  const frame = document.getElementById('usageFrame');
  const msg = e.data || {};
  if (e.source !== frame.contentWindow) return;
  if (msg.type === 'height') frame.style.height = Math.max(320, Number(msg.h) + 2) + 'px';
  else if (msg.type === 'refresh') loadUsage(true);
  else if (msg.type === 'show') { usageState.show = msg.show === 'left' ? 'left' : 'used'; renderUsage(); }
  else if (msg.type === 'toggle') { usageState.detailed = !!msg.detailed; renderUsage(); }
});

document.getElementById('tabs').addEventListener('click', function (e) {
  const tab = e.target.dataset && e.target.dataset.tab;
  if (!tab) return;
  document.querySelectorAll('#tabs button').forEach(function (b) { b.classList.toggle('active', b === e.target); });
  document.getElementById('agentsPane').style.display = tab === 'agents' ? '' : 'none';
  document.getElementById('plansPane').style.display = tab === 'plans' ? '' : 'none';
  document.getElementById('usagePane').style.display = tab === 'usage' ? '' : 'none';
  document.getElementById('architecturePane').style.display = tab === 'architecture' ? '' : 'none';
  if (tab === 'usage') loadUsage(false);
  if (tab === 'architecture' && !document.getElementById('archScript')) {
    const sc = document.createElement('script');
    sc.id = 'archScript';
    sc.src = '/assets/architecture.js';
    document.body.appendChild(sc);
  }
});

loadTree();
watchTree();
loadBrowsers();
buildHostTabs([{{range $i, $h := .Hosts}}{{if $i}},{{end}}"{{$h}}"{{end}}]);
setInterval(function () {
  if (!treeLive) loadTree();
  if (!plansLive) loadPlans();
  if (currentHost) loadDispatches(currentHost);
}, 5000);
setInterval(loadBrowsers, 30000);
</script>
