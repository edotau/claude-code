<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="csrf-token" content="{{.CSRFToken}}">
<title>claude-code web</title>
<style>
  /* Tokens from theme/DESIGN.md (The Aubergine Console); colors below reference these. */
  :root {
    color-scheme: dark; --accent: #56d4c8; --accent-fg: #1f0f1c;
    --aubergine-page: #512645; --aubergine-card: #633758; --aubergine-raised: #734469; --aubergine-well: #441d3d;
    --mist-text: #e0dce0; --mist-soft: #cfc6cd; --mist-muted: #b5acb3; --hairline: #40404055;
    --tango-green: #8ae234; --tango-green-well: #1d3a0a; --tango-red-pale: #ffa3a3; --tango-red-well: #4a1010;
    --tango-yellow: #fce94f; --tango-yellow-well: #4a3d00; --tango-blue-pale: #b0cbea; --tango-blue: #729fcf;
    --heading-white: #ffffff; --chart-pink: #f28fb0; --chart-lilac: #c7a6f0;
  }
  * { box-sizing: border-box; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .active:focus-visible, form button:focus-visible { outline-color: var(--mist-text); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline-offset: 0; }
  .arch-tl:focus-visible { outline-offset: -2px; }
  body {
    margin: 0; padding: 0.75rem; font: 15px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--aubergine-page); color: var(--mist-text);
  }
  h1 { font-size: 1.1rem; margin: 0.25rem 0 0.75rem; }
  h2 { font-size: 0.95rem; color: var(--mist-soft); margin: 1.25rem 0 0.4rem; text-transform: uppercase; letter-spacing: 0.04em; }
  section { margin-bottom: 1rem; }
  .card { background: var(--aubergine-card); border: 1px solid var(--hairline); border-radius: 10px; padding: 0.6rem 0.75rem; margin-bottom: 0.5rem; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  .muted { color: var(--mist-muted); font-size: 0.82rem; }
  .chip { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }
  .chip-running, .chip-active, .chip-working { background: var(--tango-green-well); color: var(--tango-green); }
  .chip-finished, .chip-idle, .chip-ready { background: var(--aubergine-raised); color: var(--mist-text); }
  .chip-stale, .chip-error { background: var(--tango-red-well); color: var(--tango-red-pale); }
  .chip-input-needed { background: var(--tango-yellow-well); color: var(--tango-yellow); }
  .chip-unknown, .chip-gone { background: var(--aubergine-well); color: var(--mist-muted); }
  .sub { margin-left: 0.9rem; border-left: 2px solid var(--hairline); padding-left: 0.6rem; margin-top: 0.35rem; }
  .agent-row { cursor: pointer; padding: 0.2rem 0; }
  .col { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; margin-right: 0.4rem; }
  .col-agent { width: min(13rem, 38vw); }
  @media (max-width: 600px) { .agent-row > .row > .muted { display: none; } }
  .col-status { width: 4.8rem; }
  .col-dispatch { width: min(22rem, 58vw); }
  .glyph { display: inline-block; width: 1.1em; }
  .agent-row:hover { background: var(--aubergine-raised); }
  .activity { font-size: 0.78rem; color: var(--tango-blue-pale); margin-top: 0.1rem; }
  .dispatch { font-size: 0.78rem; margin: 0.1rem 0 0 0.5rem; color: var(--mist-soft); }
  .linklike { background: none; border: none; color: var(--tango-blue-pale); width: auto; padding: 0; margin: 0; font-weight: 400; cursor: pointer; }
  #detailEvents { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.78rem; max-height: 40vh; overflow: auto; margin: 0.4rem 0 0; }
  label { display: block; font-size: 0.82rem; color: var(--mist-soft); margin: 0.5rem 0 0.2rem; }
  select, input, textarea, button {
    width: 100%; padding: 0.5rem; border-radius: 8px; border: 1px solid var(--hairline);
    background: var(--aubergine-well); color: var(--mist-text); font-size: 0.95rem;
  }
  textarea { min-height: 4.5rem; resize: vertical; }
  button { margin-top: 0.75rem; background: var(--accent); border-color: var(--accent); color: var(--accent-fg); font-weight: 600; cursor: pointer; }
  button:disabled { opacity: 0.6; }
  #dispatchResult { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.8rem; margin-top: 0.5rem; }
  #hostTabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  #hostTabs button, #usageDays button { width: auto; min-height: 1.75rem; margin-top: 0; background: var(--aubergine-raised); border-color: var(--hairline); color: var(--mist-text); font-weight: 400; }
  #hostTabs button { padding: 0.3rem 0.6rem; }
  #usageDays button { padding: 0.2rem 0.7rem; }
  #hostTabs button.active, #usageDays button.active { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
  #tabs { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-bottom: 0.75rem; }
  #tabs button { width: auto; min-height: 1.75rem; margin: 0; padding: 0.3rem 0.1rem; background: none; border: 0; border-bottom: 2px solid transparent; border-radius: 0; color: var(--mist-soft); font-weight: 400; }
  #tabs button:hover { color: var(--mist-text); }
  #tabs button.active { border-bottom-color: var(--accent); color: var(--heading-white); }
  .bar { height: 6px; background: var(--hairline); border-radius: 3px; margin: 0.35rem 0 0.2rem; overflow: hidden; }
  .bar > span { display: block; height: 100%; background: var(--tango-green); }
  .plan-row { cursor: pointer; }
  .plan-x { margin-top: 0.5rem; cursor: default; border-top: 1px solid var(--hairline); padding-top: 0.4rem; }
  .task { margin: 0.25rem 0; display: flex; gap: 0.5rem; align-items: baseline; }
  .task input { width: 1.1rem; height: 1.1rem; flex: none; padding: 0; margin: 0; }
  .plan-err { color: var(--tango-red-pale); font-size: 0.8rem; margin: 0.3rem 0; }
  .row-open { width: auto; margin: 0; padding: 0; border: 0; border-radius: 4px; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .id-tag { width: auto; min-height: 24px; margin: 0; padding: 0.15rem 0.35rem; border: 0; border-radius: 4px; background: var(--aubergine-well); color: inherit; font: 0.72rem/1.4 ui-monospace, monospace; cursor: copy; }
  #detailCloseBtn { padding: 0.25rem 0.3rem; min-height: 1.5rem; }
  .plan-row .row-open { font-weight: 700; }
  .col-agent.row-open { width: min(13rem, 38vw); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .load-err { color: var(--tango-red-pale); font-size: 0.82rem; margin: 0.3rem 0; }
  h1 .chip { vertical-align: middle; margin-left: 0.4rem; }
  #liveAge { font-weight: 400; margin-left: 0.3rem; }
  .plan-x details { margin: 0.25rem 0; }
  .plan-x summary { cursor: pointer; font-size: 0.8rem; color: var(--mist-soft); }
  .task code { background: var(--aubergine-well); padding: 0 0.3rem; border-radius: 4px; cursor: pointer; }
  .plan-more pre { white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: 0.78rem; margin: 0.4rem 0 0.6rem; }
  /* The --vscode-* variables the shared usage-view.js reads; copied into its iframe. Ubuntu terminal palette, dark only. */
  :root {
    --vscode-foreground: var(--mist-text); --vscode-sideBar-background: var(--aubergine-page); --vscode-descriptionForeground: var(--mist-muted);
    --vscode-widget-border: var(--hairline); --vscode-button-background: var(--accent); --vscode-button-foreground: var(--accent-fg);
    --vscode-badge-background: #5f5961; --vscode-badge-foreground: var(--heading-white); --vscode-charts-blue: var(--tango-blue);
    --vscode-charts-green: var(--tango-green); --vscode-charts-orange: var(--chart-pink); --vscode-charts-yellow: var(--chart-lilac);
    --vscode-editorWarning-foreground: var(--tango-yellow); --vscode-editorError-foreground: var(--tango-red-pale);
    --vscode-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  #architecturePane { overflow-wrap: anywhere; }
  .arch-body a { color: var(--tango-blue-pale); text-decoration: none; }
  .arch-body a:hover { text-decoration: underline; }
  .arch-split { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 0 0.8rem; align-items: start; }
  .arch-left { min-width: 0; }
  .arch-left input { margin: 0 0 0.5rem; font-size: 0.85rem; }
  .arch-tree { background: var(--aubergine-card); border: 1px solid var(--hairline); border-radius: 10px; padding: 0.4rem 0; overflow: auto; max-height: 80vh; font: 0.78rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .arch-tl { width: max-content; min-width: 100%; padding: 0 0.6rem; white-space: pre; cursor: pointer; color: var(--mist-soft); }
  .arch-tl:hover { background: var(--aubergine-raised); }
  .arch-tl.sel { background: var(--aubergine-raised); box-shadow: inset 2px 0 0 var(--accent); }
  .arch-tn { display: inline-block; min-width: var(--nw, 30ch); }
  .arch-d { color: var(--heading-white); }
  .arch-tc { color: var(--mist-muted); }
  .arch-detail { position: sticky; top: 0.5rem; max-height: calc(100vh - 1rem); overflow: auto; background: var(--aubergine-card); border: 1px solid var(--hairline); border-radius: 10px; padding: 0.3rem 0.8rem 0.6rem; font-size: 0.86rem; }
  .arch-detail h4 { font-size: 0.85rem; color: var(--mist-soft); margin: 0.8rem 0 0.3rem; }
  .arch-title { text-transform: none; letter-spacing: 0; color: var(--heading-white); font-size: 1rem; margin: 0.6rem 0 0.3rem; font-family: ui-monospace, monospace; }
  .arch-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.25rem 0; }
  .arch-chip { display: inline-block; padding: 0.1rem 0.5rem; background: var(--aubergine-raised); border: 1px solid var(--hairline); border-radius: 999px; font-size: 0.75rem; }
  .arch-field { margin: 0.35rem 0; }
  @media (max-width: 700px) {
    .arch-split { grid-template-columns: minmax(0, 1fr); gap: 0.8rem 0; }
    .arch-tree { max-height: 60vh; }
    .arch-detail { position: static; max-height: none; }
  }
  #usageFrame { width: 100%; min-height: 320px; height: 70vh; border: 1px solid var(--vscode-widget-border); border-radius: 10px; }
</style>
</head>
<body>
<h1>claude-code web<span id="liveStatus" class="chip chip-unknown" role="status">connecting</span><span id="liveAge" class="muted"></span></h1>
<span id="copyStatus" class="sr-only" role="status"></span>
<div id="tabs" role="tablist" aria-label="Views">
  <button type="button" role="tab" id="tab-agents" aria-controls="agentsPane" aria-selected="true" data-tab="agents" class="active">Agents</button>
  <button type="button" role="tab" id="tab-dispatch" aria-controls="dispatchPane" aria-selected="false" tabindex="-1" data-tab="dispatch">Dispatch</button>
  <button type="button" role="tab" id="tab-plans" aria-controls="plansPane" aria-selected="false" tabindex="-1" data-tab="plans">Plans</button>
  <button type="button" role="tab" id="tab-usage" aria-controls="usagePane" aria-selected="false" tabindex="-1" data-tab="usage">Usage</button>
  <button type="button" role="tab" id="tab-architecture" aria-controls="architecturePane" aria-selected="false" tabindex="-1" data-tab="architecture">Architecture</button>
</div>

<div id="architecturePane" role="tabpanel" aria-labelledby="tab-architecture" style="display:none"></div>

<div id="usagePane" role="tabpanel" aria-labelledby="tab-usage" style="display:none">
  <p class="muted"><span id="usageDays"><button type="button" data-days="7">7d</button> <button type="button" data-days="30">30d</button></span> <span id="usageStatus" role="status">loading…</span></p>
  <iframe id="usageFrame" sandbox="allow-scripts" title="Usage" hidden></iframe>
</div>

<div id="dispatchPane" role="tabpanel" aria-labelledby="tab-dispatch" style="display:none">
<section>
  <h2>Dispatches</h2>
  <div id="hostTabs"></div>
  <div id="dispatches"><p class="muted">select a host</p></div>
</section>

<section>
  <h2>Dispatch</h2>
  <form id="dispatchForm">
    <label for="f-host">Host</label>
    <select id="f-host" name="host">
      {{range .Hosts}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>

    <label for="f-agent">Agent</label>
    <select id="f-agent" name="agent">
      {{range .Agents}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>

    <label for="f-dir">Directory</label>
    <input id="f-dir" name="dir" placeholder="~/project">

    <label for="f-task">Task</label>
    <textarea id="f-task" name="task" placeholder="What should the agent do?" required></textarea>

    <button type="submit">Dispatch</button>
  </form>
  <div id="dispatchResult" role="status"></div>
</section>
</div>

<div id="plansPane" role="tabpanel" aria-labelledby="tab-plans" style="display:none">
  <section>
    <h2>Plans</h2>
    <div id="plansList"><p class="muted">loading…</p></div>
  </section>
</div>

<div id="agentsPane" role="tabpanel" aria-labelledby="tab-agents">
<section>
  <h2>Agents</h2>
  <div id="tree"><p class="muted">loading…</p></div>
</section>

<section id="detailSection" style="display:none">
  <h2>Agent <button type="button" class="linklike" id="detailCloseBtn" aria-label="Close agent detail">[close]</button></h2>
  <div id="detail"></div>
</section>

<section>
  <h2>Browsers</h2>
  <div id="browsers"><p class="muted">loading…</p></div>
</section>

</div>

<script>
const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
let currentHost = null;

function escapeHTML(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function chip(status) {
  return '<span class="chip chip-' + escapeHTML(status) + '">' + escapeHTML(status) + '</span>';
}

function statusCol(status) { return '<span class="col col-status">' + chip(status) + '</span>'; }

// idTag shows label or a short id; a click copies the full value, which SendMessage and `network view` take.
function idTag(id, label) {
  if (!id) return '';
  return '<button type="button" class="id-tag" data-focus-key="copy:' + escapeHTML(id) + '" data-id="' + escapeHTML(id) + '" title="' + escapeHTML(id) + ' (click to copy)" aria-label="copy ' + escapeHTML(id) + '">' + escapeHTML(label || id.slice(0, 8)) + '</button>';
}

// copyText falls back to execCommand: the tailnet page is plain http, where navigator.clipboard is undefined.
function copyText(text) {
  if (navigator.clipboard) return navigator.clipboard.writeText(text);
  const ta = document.createElement('textarea');
  ta.value = text;
  document.body.appendChild(ta);
  ta.select();
  const ok = document.execCommand('copy');
  ta.remove();
  return ok ? Promise.resolve() : Promise.reject(new Error('copy failed'));
}

// statusGlyph mirrors internal/agent/tree/render.go's statusGlyph: one marker per status at a glance.
function statusGlyph(status) {
  return { running: '●', finished: '✓', error: '✗', stale: '·' }[status] || ' ';
}

function renderActivity(a) {
  if (!a || (!a.tool && !a.text)) return '';
  const text = a.tool ? (a.tool + (a.arg ? ' ' + a.arg : '')) : a.text;
  return '<div class="activity">' + escapeHTML(text) + '</div>';
}

// renderDispatch mirrors internal/agenttree/render.go's formatDispatch: "↳ codex gpt-6-astra running 2m14s".
function renderDispatch(l) {
  const name = l.fallback ? escapeHTML(l.fallback) + '→' + escapeHTML(l.agent) : escapeHTML(l.agent);
  let line = '<span class="col col-dispatch">↳ ' + name + ' ' + escapeHTML(l.model || '') + '</span>' + statusCol(l.status) + idTag(l.id) + ' ' + escapeHTML(l.duration || '');
  if (l.fallback) line += ' ⚠ fallback';
  return '<div class="dispatch">' + line + '</div>';
}

function renderSubagents(subs, sessionId) {
  if (!subs || !subs.length) return '';
  return '<div class="sub">' + subs.map(function (s) {
    return '<div class="agent-row" data-session="' + escapeHTML(sessionId) + '" data-agent="' + escapeHTML(s.id) + '">' +
      '<div class="row"><span><button type="button" class="col col-agent row-open" data-focus-key="open:' + escapeHTML(s.id) + '"><span class="glyph" aria-hidden="true">' + statusGlyph(s.status) + '</span>' + escapeHTML(s.type || s.id) + '</button>' + statusCol(s.status) + idTag(s.id) + '</span>' +
      '<span class="muted">' + escapeHTML(s.lastTool || '') + '</span></div>' +
      renderActivity(s.activity) +
      (s.dispatches || []).map(renderDispatch).join('') +
      '</div>';
  }).join('') + '</div>';
}

// phaseDone mirrors internal/agenttree/render.go's phaseDone: agents with a finished/error result vs. total.
function phaseDone(agents) {
  let done = 0;
  (agents || []).forEach(function (a) { if (a.status === 'finished' || a.status === 'error') done++; });
  return done;
}

function renderWorkflows(runs, sessionId) {
  if (!runs || !runs.length) return '';
  return '<div class="sub">' + runs.map(function (run) {
    return '<div class="card"><div class="row"><span>workflow ' + escapeHTML(run.name || run.id) + ' ' + chip(run.status) + '</span></div>' +
      (run.phases || []).map(function (phase) {
        const total = (phase.agents || []).length;
        return '<div class="muted">phase ' + escapeHTML(phase.name) + ' (' + phaseDone(phase.agents) + '/' + total + ' done)</div>' +
          renderSubagents(phase.agents, sessionId);
      }).join('') +
      '</div>';
  }).join('') + '</div>';
}

function renderTree(tree) {
  const sessions = tree.sessions || [];
  if (!sessions.length) return '<p class="muted">no recent sessions</p>';
  return sessions.map(function (s) {
    return '<div class="card">' +
      '<div class="row"><strong>' + escapeHTML(s.title || s.project || s.id) + '</strong><span>' + idTag(s.name, s.name) + ' ' + idTag(s.id) + ' ' + chip(s.status) + '</span></div>' +
      '<div class="muted">' + escapeHTML(s.cwd || '') + (s.branch ? ' @' + escapeHTML(s.branch) : '') + '</div>' +
      renderSubagents(s.subagents, s.id) +
      renderWorkflows(s.workflows, s.id) +
      '</div>';
  }).join('');
}

function renderDispatches(statuses) {
  if (!statuses || !statuses.length) return '<p class="muted">no cc-* panes</p>';
  return statuses.map(function (p) {
    return '<div class="card"><div class="row"><strong>' + escapeHTML(p.session) + '</strong>' +
      chip(p.state) + '</div>' +
      '<div class="muted">' + escapeHTML(p.agent || '') + ' &middot; ' + escapeHTML(p.reason || '') + '</div></div>';
  }).join('');
}

// eventLine mirrors internal/agenttree/view.go's formatEvent for one Snapshot.Events entry.
function eventLine(e) {
  const ts = e.at ? new Date(e.at).toLocaleTimeString() : '';
  if (e.kind === 'tool') return ts + ' tool ' + (e.tool || '') + ' ' + (e.arg || '');
  if (e.kind === 'text') return ts + ' text "' + (e.text || '') + '"';
  if (e.kind === 'result') return ts + ' result ' + (e.size || 0) + ' B';
  return ts;
}

function renderSnapshot(snap) {
  let html = '<div class="row"><strong>' + escapeHTML(snap.label || snap.id) + '</strong>' + chip(snap.status) + '</div>';
  if (snap.workflow) html += '<div class="muted">workflow ' + escapeHTML(snap.workflow) + ' phase ' + escapeHTML(snap.phase || '') + '</div>';
  html += '<div class="muted">' + escapeHTML(snap.model || '') + (snap.effort ? ' effort=' + escapeHTML(snap.effort) : '') + '</div>';
  html += renderActivity(snap.activity);
  (snap.filesEdited || []).forEach(function (f) { html += '<div class="muted">edited ' + escapeHTML(f) + '</div>'; });
  (snap.dispatches || []).forEach(function (l) { html += renderDispatch(l); });
  if (snap.result) html += '<div class="muted">result: ' + escapeHTML(snap.result) + '</div>';
  const lines = (snap.events || []).map(eventLine).join('\n');
  html += '<pre id="detailEvents">' + escapeHTML(lines) + '</pre>';
  return html;
}

function closeDetail() {
  if (window._detailAbort) window._detailAbort.abort();
  document.getElementById('detailSection').style.display = 'none';
  document.getElementById('detail').innerHTML = '';
}

// followDetail streams /api/view?follow=1's text/plain lines into #detailEvents as they arrive,
// aborted by closeDetail or by opening a different agent.
function followDetail(sessionId, agentId) {
  const controller = new AbortController();
  window._detailAbort = controller;
  fetch('/api/view?session=' + encodeURIComponent(sessionId) + '&agent=' + encodeURIComponent(agentId) + '&follow=1', { signal: controller.signal })
    .then(function (r) {
      const reader = r.body.getReader();
      const decoder = new TextDecoder();
      const pre = document.getElementById('detailEvents');
      function pump() {
        return reader.read().then(function (res) {
          if (res.done || !pre) return;
          pre.textContent += decoder.decode(res.value, { stream: true });
          return pump();
        });
      }
      return pump();
    })
    .catch(function (err) {
      if (err.name === 'AbortError') return;
      const pre = document.getElementById('detailEvents');
      if (pre) pre.textContent += '\n[stream ended: ' + String(err.message || err) + ']';
    });
}

function openDetail(sessionId, agentId) {
  if (window._detailAbort) window._detailAbort.abort();
  const section = document.getElementById('detailSection');
  const el = document.getElementById('detail');
  section.style.display = '';
  el.innerHTML = '<p class="muted">loading…</p>';
  getJSON('/api/view?session=' + encodeURIComponent(sessionId) + '&agent=' + encodeURIComponent(agentId))
    .then(function (snap) {
      el.innerHTML = renderSnapshot(snap);
      if (snap.status === 'running') followDetail(sessionId, agentId);
    })
    .catch(function (err) { el.innerHTML = '<p class="muted">' + escapeHTML(String(err.message || err)) + '</p>'; });
}

function renderBrowsers(rep) {
  const browsers = (rep && rep.browsers) || [];
  if (!browsers.length) return '<p class="muted">no browsers detected</p>';
  return browsers.map(function (b) {
    const paths = b.paths || {};
    const mark = b.default ? ' <span class="muted">(default)</span>' : '';
    return '<div class="card"><div class="row"><strong>' + escapeHTML(b.displayName || b.name) + '</strong>' + mark + '</div>' +
      '<div class="muted">host=' + escapeHTML(b.host || '') + ' extension=' + escapeHTML(paths.extension || '') +
      ' cdp=' + escapeHTML(paths.cdp || '') + ' webdriver=' + escapeHTML(paths.webdriver || '') +
      ' gui=' + escapeHTML(paths.gui || '') + '</div></div>';
  }).join('');
}

// focusKey names the focused control across live redraws; a deliberate blur (target still in the page) clears it.
let focusKey = '';
document.addEventListener('focusin', function (e) { focusKey = e.target.dataset.focusKey || ''; });
document.addEventListener('focusout', function (e) {
  const t = e.target; // removal fires focusout while t still counts as connected, so judge one tick later
  setTimeout(function () { if (t.isConnected && document.activeElement === document.body) focusKey = ''; });
});

// restoreFocus refocuses the redrawn control when a live redraw removed the focused one.
function restoreFocus() {
  if (!focusKey || document.activeElement !== document.body) return;
  const n = document.querySelector('[data-focus-key="' + CSS.escape(focusKey) + '"]');
  if (n) n.focus({ preventScroll: true });
}

// paintTree swaps in a tree snapshot and puts keyboard focus back where it was.
function paintTree(tree) {
  const box = document.getElementById('tree');
  box.innerHTML = renderTree(tree);
  box.dataset.loaded = '1';
  restoreFocus();
}

// getJSON fails with the server's message on a non-2xx, so callers can say why a load failed.
function getJSON(url) {
  return fetch(url).then(function (r) {
    if (r.ok) return r.json();
    return r.text().then(function (t) { throw new Error(t.trim() || 'HTTP ' + r.status); });
  });
}

// loadFailed explains an empty section; a section that already shows data (dataset.loaded === key) keeps it.
function loadFailed(box, what, err, key) {
  if (box.dataset.loaded === (key || '1')) return;
  box.innerHTML = '<p class="load-err">couldn’t load ' + what + ': ' + escapeHTML(String(err.message || err)) + ' · retrying</p>';
}

let feedState = '';
let lastUpdate = 0;
let feedRetry = 0;
let sseDown = false; // true once the event stream failed: the 5s poll is then the only source of agent state
const feedChip = { live: 'running', polling: 'idle', offline: 'error' };

// setFeed rewrites the header chip only on a state change, so screen readers hear transitions, not every tick.
function setFeed(state) {
  if (state !== 'offline') lastUpdate = Date.now();
  if (state !== feedState) {
    feedState = state;
    const c = document.getElementById('liveStatus');
    c.className = 'chip chip-' + feedChip[state];
    c.textContent = state;
  }
  paintAge();
}

function paintAge() {
  const s = Math.round((Date.now() - lastUpdate) / 1000);
  document.getElementById('liveAge').textContent = feedState === 'live' || !lastUpdate ? '' :
    'updated ' + (s < 60 ? s + 's' : Math.round(s / 60) + 'm') + ' ago';
}

function loadBrowsers() {
  const box = document.getElementById('browsers');
  getJSON('/api/browsers').then(function (rep) {
    box.innerHTML = renderBrowsers(rep);
    box.dataset.loaded = '1';
  }).catch(function (err) { loadFailed(box, 'browsers', err); });
}

let treeEpoch = 0; // bumped per SSE render; a fetch that began before one is stale and must not overwrite it
function loadTree() {
  const started = treeEpoch;
  const box = document.getElementById('tree');
  getJSON('/api/tree').then(function (tree) {
    if (treeEpoch !== started) return;
    paintTree(tree);
    if (sseDown) setFeed('polling');
  }).catch(function (err) {
    if (treeEpoch !== started) return;
    loadFailed(box, 'agents', err);
    if (sseDown) setFeed('offline');
  });
}

function loadDispatches(host) {
  if (!host) return;
  const box = document.getElementById('dispatches');
  getJSON('/api/dispatches?host=' + encodeURIComponent(host)).then(function (sessions) {
    if (host !== currentHost) return; // the user switched hosts while this was in flight
    box.innerHTML = renderDispatches(sessions);
    box.dataset.loaded = host;
  }).catch(function (err) {
    if (host === currentHost) loadFailed(box, 'dispatches on ' + escapeHTML(host), err, host);
  });
}

// markSelected marks the one button pred picks in list as active and pressed, the rest as not.
function markSelected(list, pred) {
  list.forEach(function (b) {
    const on = pred(b);
    b.classList.toggle('active', on);
    b.setAttribute('aria-pressed', String(on));
  });
}

function buildHostTabs(hosts) {
  const el = document.getElementById('hostTabs');
  el.innerHTML = hosts.map(function (h) { return '<button type="button" aria-pressed="false" data-host="' + escapeHTML(h) + '">' + escapeHTML(h) + '</button>'; }).join('');
  el.querySelectorAll('button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      markSelected(el.querySelectorAll('button'), function (b) { return b === btn; });
      currentHost = btn.dataset.host;
      loadDispatches(currentHost);
    });
  });
  if (hosts.length) el.querySelector('button').click();
}

document.getElementById('dispatchForm').addEventListener('submit', function (e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button');
  btn.disabled = true;
  const body = new URLSearchParams(new FormData(form));
  fetch('/api/dispatch', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrfToken },
    body: body.toString(),
  }).then(function (r) { return r.text().then(function (t) { return { ok: r.ok, text: t }; }); })
    .then(function (res) {
      document.getElementById('dispatchResult').textContent = res.text;
      if (res.ok && currentHost) loadDispatches(currentHost);
    }).catch(function (err) {
      document.getElementById('dispatchResult').textContent = String(err);
    }).finally(function () { btn.disabled = false; });
});

document.getElementById('tree').addEventListener('click', function (e) {
  const tag = e.target.closest('.id-tag');
  if (tag) {
    const short = tag.textContent;
    const said = document.getElementById('copyStatus');
    copyText(tag.dataset.id).then(function () {
      said.textContent = 'copied ' + tag.dataset.id;
      tag.textContent = 'copied';
      setTimeout(function () { tag.textContent = short; }, 900);
    }).catch(function () { tag.textContent = 'copy failed'; said.textContent = 'copy failed'; });
    return;
  }
  const row = e.target.closest('.agent-row');
  if (!row) return;
  openDetail(row.dataset.session, row.dataset.agent);
});
document.getElementById('detailCloseBtn').addEventListener('click', closeDetail);

let treeLive = false;
function watchTree() {
  if (!window.EventSource) { sseDown = true; return; }
  const es = new EventSource('/api/events');
  es.onopen = function () { feedRetry = 0; sseDown = false; setFeed('live'); };
  es.addEventListener('tree', function (e) {
    try {
      const t = JSON.parse(e.data);
      treeEpoch++;
      paintTree(t);
      treeLive = true;
      setFeed('live');
    } catch (err) {}
  });
  es.addEventListener('plans', function (e) {
    try { plansLive = true; renderPlans(JSON.parse(e.data)); if (openPlan) showPlan(openPlan); } catch (err) {}
  });
  // onerror closes and retries with backoff (2s doubling to 60s); the poll answers live/offline in the meantime.
  es.onerror = function () {
    es.close();
    treeLive = false;
    plansLive = false;
    sseDown = true;
    loadTree();
    setTimeout(watchTree, Math.min(60000, 2000 * Math.pow(2, feedRetry++)));
  };
}

let plansList = [];
let openPlan = null;
let plansLive = false;
function loadPlans() {
  getJSON('/api/plans')
    .then(function (l) { renderPlans(l); if (openPlan) showPlan(openPlan); })
    .catch(function (err) { loadFailed(document.getElementById('plansList'), 'plans', err); });
}
function el(tag, cls, text) {
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text != null) n.textContent = text;
  return n;
}

const planX = el('div', 'plan-x'); // the open plan's expansion, parked off-DOM across list rebuilds
const planPark = document.createDocumentFragment();
let planFullOpen = false; // the open plan's Show full plan state, kept across re-renders

function renderPlans(list) {
  plansList = list || [];
  const box = document.getElementById('plansList');
  planPark.appendChild(planX);
  box.textContent = '';
  box.dataset.loaded = '1';
  if (!plansList.length) { box.appendChild(el('p', 'muted', 'no plans')); return; }
  const byRepo = new Map();
  plansList.forEach(function (p) { if (!byRepo.has(p.repo)) byRepo.set(p.repo, []); byRepo.get(p.repo).push(p); });
  Array.from(byRepo.keys()).sort().forEach(function (repo) {
    box.appendChild(el('h2', null, repo));
    byRepo.get(repo).forEach(function (p) { box.appendChild(planCard(p)); });
  });
  const open = openPlan && planCardFor(openPlan);
  if (open) open.appendChild(planX);
  restoreFocus();
}

function planCard(p) {
  const card = el('div', 'card plan-row');
  card.dataset.path = p.path;
  const row = el('div', 'row');
  const open = el('button', 'row-open', p.path.split('/').pop());
  open.type = 'button';
  open.setAttribute('aria-expanded', String(openPlan === p.path));
  open.dataset.focusKey = 'plan:' + p.path;
  row.appendChild(open);
  row.appendChild(el('span', 'muted', p.ticked + '/' + p.total + (p.claims.length ? ' · ' + p.claims.length + ' claimed' : '')));
  card.appendChild(row);
  const bar = el('div', 'bar');
  const fill = document.createElement('span');
  fill.style.width = (p.total ? Math.round(100 * p.ticked / p.total) : 0) + '%';
  bar.appendChild(fill);
  card.appendChild(bar);
  card.addEventListener('click', function (e) {
    if (e.target.closest('.plan-x')) return;
    if (openPlan === p.path) closePlan(); else showPlan(p.path);
  });
  return card;
}

function planCardFor(path) {
  return Array.from(document.querySelectorAll('.plan-row')).find(function (c) { return c.dataset.path === path; });
}

function userTitle(mark) {
  const m = /^(ticked|unticked)\s+(\S+)$/.exec(mark || '');
  return m ? m[1] + ' by you ' + m[2] : '';
}

function postTick(path, t, done, cb) {
  cb.disabled = true;
  fetch('/api/plan/tick', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ path: path, line: t.line, title: t.title, done: done }),
  }).then(function (r) {
    if (r.ok) return showPlan(path);
    return r.text().then(function (m) { throw new Error(m.trim() || 'HTTP ' + r.status); });
  }).catch(function (err) {
    cb.checked = !done;
    cb.disabled = false;
    planX.querySelectorAll('.plan-err').forEach(function (n) { n.remove(); });
    const msg = el('div', 'plan-err', 'Tick failed: ' + String(err.message || err));
    msg.setAttribute('role', 'alert');
    planX.prepend(msg);
  });
}

function taskRow(path, t) {
  const row = el('label', 'task');
  const cb = document.createElement('input');
  cb.type = 'checkbox';
  cb.checked = t.done;
  cb.dataset.focusKey = 'task:' + path + ':' + t.line;
  if (t.userMark) cb.title = userTitle(t.userMark);
  cb.addEventListener('change', function () { postTick(path, t, cb.checked, cb); });
  const text = el('span', null, t.title + ' ');
  if (t.sha) text.appendChild(el('code', null, t.sha));
  if (t.claim) text.appendChild(el('div', 'activity', 'claim: ' + t.claim));
  t.partial.forEach(function (n) { text.appendChild(el('div', 'activity', 'partly landed: ' + n)); });
  row.appendChild(cb);
  row.appendChild(text);
  return row;
}

// planFull is the one closed container: the markdown in its original order, minus the task lines listed below it.
function planFull(d) {
  const taskLines = new Set(d.tasks.map(function (t) { return t.line; }));
  const rest = (d.markdown || '').split('\n').filter(function (ln, i) { return !taskLines.has(i + 1); }).join('\n')
    .replace(/<!--[\s\S]*?-->/g, '').replace(/\n{3,}/g, '\n\n').trim();
  if (!rest) return null;
  const det = el('details', 'plan-more');
  det.appendChild(el('summary', null, 'Show full plan'));
  det.appendChild(el('pre', null, rest));
  det.open = planFullOpen;
  det.addEventListener('toggle', function () { planFullOpen = det.open; });
  return det;
}

function renderPlanDetail(d) {
  planX.textContent = '';
  const full = planFull(d);
  if (full) planX.appendChild(full);
  d.tasks.forEach(function (t) { planX.appendChild(taskRow(d.path, t)); });
  restoreFocus();
}

function showPlan(path) {
  const card = planCardFor(path);
  const top = card && card.getBoundingClientRect().top; // a plan open above collapses: hold this row where it was
  if (openPlan !== path) { planX.textContent = ''; planFullOpen = false; }
  if (openPlan && openPlan !== path) markPlanOpen(openPlan, false);
  openPlan = path;
  markPlanOpen(path, true);
  if (card && planX.parentNode !== card) { card.appendChild(planX); window.scrollBy(0, card.getBoundingClientRect().top - top); }
  return getJSON('/api/plan?path=' + encodeURIComponent(path))
    .then(function (d) { if (openPlan === path) renderPlanDetail(d); })
    .catch(function (err) {
      planX.textContent = '';
      planX.appendChild(el('p', 'muted', String(err.message || err)));
    });
}

// markPlanOpen mirrors the open plan on its card's header button for screen readers.
function markPlanOpen(path, open) {
  const card = planCardFor(path);
  const b = card && card.querySelector('.row-open');
  if (b) b.setAttribute('aria-expanded', String(open));
}

function closePlan() {
  if (openPlan) markPlanOpen(openPlan, false);
  openPlan = null;
  planPark.appendChild(planX);
}

// Usage tab: the vscode extension's CommonJS modules (served from /assets/usage/) behind a minimal require shim.
const USAGE_MODULES = ['format', 'pricing', 'usage-model', 'usage-view'];
const USAGE_VARS = ['foreground', 'sideBar-background', 'descriptionForeground', 'widget-border', 'button-background',
  'button-foreground', 'badge-background', 'badge-foreground', 'charts-blue', 'charts-green', 'charts-orange',
  'charts-yellow', 'editorWarning-foreground', 'editorError-foreground', 'font-family'];
const usageState = { json: null, jsonDays: 0, show: 'left', detailed: true, days: 7, mods: null, skeleton: false, pending: false, sig: '' };

function loadUsageModules() {
  if (usageState.mods) return usageState.mods;
  usageState.mods = Promise.all(USAGE_MODULES.map(function (n) {
    return fetch('/assets/usage/' + n + '.js').then(function (r) {
      if (!r.ok) throw new Error(n + '.js: HTTP ' + r.status);
      return r.text();
    });
  })).then(function (srcs) {
    const cache = {};
    function req(id) {
      const i = USAGE_MODULES.indexOf(id.replace(/^\.\//, ''));
      if (i < 0) throw new Error('unknown module ' + id);
      if (!cache[i]) {
        const m = cache[i] = { exports: {} };
        new Function('require', 'module', 'exports', srcs[i])(req, m, m.exports);
      }
      return cache[i].exports;
    }
    return { model: req('usage-model'), view: req('usage-view') };
  });
  return usageState.mods;
}

function usageThemeCSS() {
  const cs = getComputedStyle(document.documentElement);
  return ':root{color-scheme:' + cs.colorScheme + ';' + USAGE_VARS.map(function (v) {
    return '--vscode-' + v + ':' + cs.getPropertyValue('--vscode-' + v) + ';';
  }).join('') + '}';
}

const SKELETON_MODEL = { providers: [], api: [], agents: [], stats: null, providerModels: [] };

function usageBridge(nonce) {
  return '<style>' + usageThemeCSS() + '</style><script nonce="' + nonce + '">' +
    'window.acquireVsCodeApi=function(){return{postMessage:function(m){parent.postMessage(m,"*")}}};' +
    'addEventListener("DOMContentLoaded",function(){new ResizeObserver(function(){' +
    'parent.postMessage({type:"height",h:document.body.scrollHeight},"*")}).observe(document.body)});' +
    '<\/script>';
}

function renderUsage() {
  const st = usageState;
  if (!st.json && !st.skeleton) return;
  loadUsageModules().then(function (m) {
    const sig = JSON.stringify([st.json, st.show, st.detailed, st.days, st.skeleton, st.pending]);
    if (sig === st.sig) return;
    st.sig = sig;
    const nonce = Array.from(crypto.getRandomValues(new Uint8Array(12)), function (b) { return b.toString(16).padStart(2, '0'); }).join('');
    const model = st.skeleton ? SKELETON_MODEL : m.model.buildUsageModel(st.json, null, Date.now());
    const html = m.view.renderUsageHtml(model, { detailed: st.detailed, show: st.show, days: st.days, nonce: nonce,
      skeleton: st.skeleton, quotasPending: st.pending });
    const frame = document.getElementById('usageFrame');
    if (!frame.hidden) frame.style.minHeight = frame.offsetHeight + 'px'; // hold the height until the new body reports its own
    frame.srcdoc = html.replace('<head>', '<head>' + usageBridge(nonce));
    frame.hidden = false;
  }).catch(function (err) {
    document.getElementById('usageStatus').textContent = 'usage render failed: ' + err.message;
  });
}

function usageRead(days) {
  try { return JSON.parse(localStorage.getItem('usage:' + days)); } catch (err) { return null; }
}

function usageWrite(days, j) {
  try { localStorage.setItem('usage:' + days, JSON.stringify(j)); } catch (err) {}
}

function usageFetch(days, query) {
  return fetch('/api/usage?days=' + days + query).then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  });
}

let usageSeq = 0; // bumped per load; a response for an older load (another days window) is dropped

// usageShow puts j on screen for `days`; pending marks a body that has no quota data yet.
function usageShow(days, j, pending) {
  Object.assign(usageState, { json: j, jsonDays: days, skeleton: !j, pending: pending });
  renderUsage();
}

function loadUsage(fresh) {
  const days = usageState.days, seq = ++usageSeq;
  const status = document.getElementById('usageStatus');
  status.textContent = 'updating…';
  const known = usageRead(days) || (usageState.jsonDays === days ? usageState.json : null);
  usageShow(days, known, false);
  const kept = known && known.providers && known.providers.length ? known.providers : null;
  usageFetch(days, '&quotas=0').then(function (local) {
    if (seq !== usageSeq) return;
    if (kept && !(local.providers && local.providers.length)) local = Object.assign({}, local, { providers: kept });
    usageShow(days, local, !(local.providers && local.providers.length));
  }).catch(function () {}).then(function () {
    return usageFetch(days, fresh ? '&fresh=1' : '');
  }).then(function (j) {
    if (seq !== usageSeq) return;
    usageWrite(days, j);
    usageShow(days, j, false);
    status.textContent = '';
  }).catch(function (err) {
    if (seq === usageSeq) status.textContent = 'usage unavailable: ' + err.message;
  });
}

function markUsageDays() {
  markSelected(document.querySelectorAll('#usageDays button'), function (b) { return Number(b.dataset.days) === usageState.days; });
}

document.getElementById('usageDays').addEventListener('click', function (e) {
  const d = Number(e.target.dataset && e.target.dataset.days);
  if (!d || d === usageState.days) return;
  usageState.days = d;
  markUsageDays();
  loadUsage(false);
});
markUsageDays();

window.addEventListener('message', function (e) {
  const frame = document.getElementById('usageFrame');
  const msg = e.data || {};
  if (e.source !== frame.contentWindow) return;
  if (msg.type === 'height') { frame.style.height = Math.max(320, Number(msg.h) + 2) + 'px'; frame.style.minHeight = ''; }
  else if (msg.type === 'refresh') loadUsage(true);
  else if (msg.type === 'show') { usageState.show = msg.show === 'left' ? 'left' : 'used'; renderUsage(); }
  else if (msg.type === 'toggle') { usageState.detailed = !!msg.detailed; renderUsage(); }
});

// Arrow keys, Home and End move between the view tabs (WAI-ARIA tabs pattern, automatic activation).
document.getElementById('tabs').addEventListener('keydown', function (e) {
  const tabs = Array.from(document.querySelectorAll('#tabs [role="tab"]'));
  const i = tabs.indexOf(document.activeElement);
  const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
  let next = -1;
  if (step) next = (i + step + tabs.length) % tabs.length;
  else if (e.key === 'Home') next = 0;
  else if (e.key === 'End') next = tabs.length - 1;
  if (i < 0 || next < 0) return;
  e.preventDefault();
  tabs[next].focus();
  tabs[next].click();
});

document.getElementById('tabs').addEventListener('click', function (e) {
  const tab = e.target.dataset && e.target.dataset.tab;
  if (!tab) return;
  document.querySelectorAll('#tabs button').forEach(function (b) {
    const on = b === e.target;
    b.classList.toggle('active', on);
    b.setAttribute('aria-selected', String(on));
    b.tabIndex = on ? 0 : -1;
  });
  document.querySelectorAll('[role="tabpanel"]').forEach(function (p) { p.style.display = p.id === tab + 'Pane' ? '' : 'none'; });
  if (tab === 'usage') loadUsage(false);
  if (tab === 'architecture' && !document.getElementById('archScript')) {
    const sc = document.createElement('script');
    sc.id = 'archScript';
    sc.src = '/assets/architecture.js';
    document.body.appendChild(sc);
  }
});
if (/^#arch/.test(location.hash)) document.querySelector('#tabs [data-tab="architecture"]').click();

loadTree();
watchTree();
loadBrowsers();
buildHostTabs([{{range $i, $h := .Hosts}}{{if $i}},{{end}}"{{$h}}"{{end}}]);
setInterval(function () {
  if (!treeLive) loadTree();
  if (!plansLive) loadPlans();
  if (currentHost) loadDispatches(currentHost);
  paintAge();
}, 5000);
setInterval(loadBrowsers, 30000);
</script>
</body>
</html>
